                            	   314: ; =============================================================================
                            	   315: ; planar_to_packed_conv
                            	   316: ; Interleave one decoded batch (d2 bytes from EACH of the 4 plane scratch
                            	   317: ; buffers) into packed 4bpp pixel data, written to (a1)+.
                            	   318: ; Every 1 byte consumed from each of the 4 planes (8 bits = 8 pixels'
                            	   319: ; worth of that bit position) produces 8 pixels of packed output (4
                            	   320: ; bytes / 2 words), built 1 pixel nibble at a time: shift a bit out of
                            	   321: ; each of the 4 plane registers, rotate it into the accumulator -- 4
                            	   322: ; shifts per pixel nibble.
                            	   323: ; =============================================================================
                            	   324: planar_to_packed_conv:
00:000009A2 4A42            	   325:     tst.w   d2
00:000009A4 6700007A        	   326:     beq.w   .exit
00:000009A8 48E76000        	   327:     movem.l d2/d1,-(sp)
00:000009AC 45F900000000    	   328:     lea     (plane_buf0),a2
00:000009B2 5342            	   329:     subi.w  #1,d2
                            	   330: .byte_loop:
00:000009B4 4842            	   331:     swap    d2
00:000009B6 1A12            	   332:     move.b  (a2),d5                  ; plane 0 byte
00:000009B8 1C2A0100        	   333:     move.b  ($100,a2),d6              ; plane 1 byte
00:000009BC 182A0200        	   334:     move.b  ($200,a2),d4              ; plane 2 byte
00:000009C0 162A0300        	   335:     move.b  ($300,a2),d3              ; plane 3 byte
00:000009C4 524A            	   336:     addq.w  #1,a2
00:000009C6 343C0001        	   337:     move.w  #1,d2
                            	   338: .pixel_pair_loop:
                            	   339: BYTE_IDX SET 0
                            	   340:     REPT 2
                            	   341:         REPT 2
                            	   342:             ; Verified bit order (traced by hand through the 9-bit
                            	   343:             ; roxl.b rotate-through-extend ring across all 8 steps that
                            	   344:             ; build one output byte -- see the equivalent derivation in
                            	   345:             ; md_tile_codec.py's module docstring for the full working):
                            	   346:             ; each pixel's final nibble = (plane3_bit<<3)|(plane2_bit<<2)
                            	   347:             ; |(plane0_bit<<1)|(plane1_bit). Note plane0 and plane1 land
                            	   348:             ; in the middle bits, not bits 0/1 as you'd naively guess --
                            	   349:             ; an earlier revision of the comments below (but NOT the
                            	   350:             ; code, which was always correct) had d5/d6 swapped relative
                            	   351:             ; to their actual load source just above (plane_buf0/buf1).
                            	   352:             lsl.b   #1,d3             ; plane 3 bit -> carry
                            	   353:             roxl.b  #1,d1             ; ...into accumulator
                            	   354:             lsl.b   #1,d4             ; plane 2 bit
                            	   355:             roxl.b  #1,d1
                            	   356:             lsl.b   #1,d5             ; plane 0 bit (d5 loaded from plane_buf0)
                            	   357:             roxl.b  #1,d1
                            	   358:             lsl.b   #1,d6             ; plane 1 bit (d6 loaded from plane_buf1)
                            	   359:             roxl.b  #1,d1
                            	   360:         ENDR
                            	   361:         IF BYTE_IDX=1
                            	   362:             rol.w   #8,d7              ; previous packed byte -> high byte
                            	   363:         ENDIF
                            	   364:         move.b  d1,d7
                            	   365: BYTE_IDX SET BYTE_IDX+1
                            	   366:     ENDR
                            	     1R         REPT 2
                            	     2R             ; Verified bit order (traced by hand through the 9-bit
                            	     3R             ; roxl.b rotate-through-extend ring across all 8 steps that
                            	     4R             ; build one output byte -- see the equivalent derivation in
                            	     5R             ; md_tile_codec.py's module docstring for the full working):
                            	     6R             ; each pixel's final nibble = (plane3_bit<<3)|(plane2_bit<<2)
                            	     7R             ; |(plane0_bit<<1)|(plane1_bit). Note plane0 and plane1 land
                            	     8R             ; in the middle bits, not bits 0/1 as you'd naively guess --
                            	     9R             ; an earlier revision of the comments below (but NOT the
                            	    10R             ; code, which was always correct) had d5/d6 swapped relative
                            	    11R             ; to their actual load source just above (plane_buf0/buf1).
                            	    12R             lsl.b   #1,d3             ; plane 3 bit -> carry
                            	    13R             roxl.b  #1,d1             ; ...into accumulator
                            	    14R             lsl.b   #1,d4             ; plane 2 bit
                            	    15R             roxl.b  #1,d1
                            	    16R             lsl.b   #1,d5             ; plane 0 bit (d5 loaded from plane_buf0)
                            	    17R             roxl.b  #1,d1
                            	    18R             lsl.b   #1,d6             ; plane 1 bit (d6 loaded from plane_buf1)
                            	    19R             roxl.b  #1,d1
                            	    20R         ENDR
                            	     1R             ; Verified bit order (traced by hand through the 9-bit
                            	     2R             ; roxl.b rotate-through-extend ring across all 8 steps that
                            	     3R             ; build one output byte -- see the equivalent derivation in
                            	     4R             ; md_tile_codec.py's module docstring for the full working):
                            	     5R             ; each pixel's final nibble = (plane3_bit<<3)|(plane2_bit<<2)
                            	     6R             ; |(plane0_bit<<1)|(plane1_bit). Note plane0 and plane1 land
                            	     7R             ; in the middle bits, not bits 0/1 as you'd naively guess --
                            	     8R             ; an earlier revision of the comments below (but NOT the
                            	     9R             ; code, which was always correct) had d5/d6 swapped relative
                            	    10R             ; to their actual load source just above (plane_buf0/buf1).
00:000009CA E30B            	    11R             lsl.b   #1,d3             ; plane 3 bit -> carry
00:000009CC E311            	    12R             roxl.b  #1,d1             ; ...into accumulator
00:000009CE E30C            	    13R             lsl.b   #1,d4             ; plane 2 bit
00:000009D0 E311            	    14R             roxl.b  #1,d1
00:000009D2 E30D            	    15R             lsl.b   #1,d5             ; plane 0 bit (d5 loaded from plane_buf0)
00:000009D4 E311            	    16R             roxl.b  #1,d1
00:000009D6 E30E            	    17R             lsl.b   #1,d6             ; plane 1 bit (d6 loaded from plane_buf1)
00:000009D8 E311            	    18R             roxl.b  #1,d1
                            	    19R         
                            	     1R             ; Verified bit order (traced by hand through the 9-bit
                            	     2R             ; roxl.b rotate-through-extend ring across all 8 steps that
                            	     3R             ; build one output byte -- see the equivalent derivation in
                            	     4R             ; md_tile_codec.py's module docstring for the full working):
                            	     5R             ; each pixel's final nibble = (plane3_bit<<3)|(plane2_bit<<2)
                            	     6R             ; |(plane0_bit<<1)|(plane1_bit). Note plane0 and plane1 land
                            	     7R             ; in the middle bits, not bits 0/1 as you'd naively guess --
                            	     8R             ; an earlier revision of the comments below (but NOT the
                            	     9R             ; code, which was always correct) had d5/d6 swapped relative
                            	    10R             ; to their actual load source just above (plane_buf0/buf1).
00:000009DA E30B            	    11R             lsl.b   #1,d3             ; plane 3 bit -> carry
00:000009DC E311            	    12R             roxl.b  #1,d1             ; ...into accumulator
00:000009DE E30C            	    13R             lsl.b   #1,d4             ; plane 2 bit
00:000009E0 E311            	    14R             roxl.b  #1,d1
00:000009E2 E30D            	    15R             lsl.b   #1,d5             ; plane 0 bit (d5 loaded from plane_buf0)
00:000009E4 E311            	    16R             roxl.b  #1,d1
00:000009E6 E30E            	    17R             lsl.b   #1,d6             ; plane 1 bit (d6 loaded from plane_buf1)
00:000009E8 E311            	    18R             roxl.b  #1,d1
                            	    19R         
                            	    21R         IF BYTE_IDX=1
                            	    22R             rol.w   #8,d7              ; previous packed byte -> high byte
                            	    23R         ENDIF
00:000009EA 1E01            	    24R         move.b  d1,d7
                            	    25R BYTE_IDX SET BYTE_IDX+1
                            	    26R     
                            	     1R         REPT 2
                            	     2R             ; Verified bit order (traced by hand through the 9-bit
                            	     3R             ; roxl.b rotate-through-extend ring across all 8 steps that
                            	     4R             ; build one output byte -- see the equivalent derivation in
                            	     5R             ; md_tile_codec.py's module docstring for the full working):
                            	     6R             ; each pixel's final nibble = (plane3_bit<<3)|(plane2_bit<<2)
                            	     7R             ; |(plane0_bit<<1)|(plane1_bit). Note plane0 and plane1 land
                            	     8R             ; in the middle bits, not bits 0/1 as you'd naively guess --
                            	     9R             ; an earlier revision of the comments below (but NOT the
                            	    10R             ; code, which was always correct) had d5/d6 swapped relative
                            	    11R             ; to their actual load source just above (plane_buf0/buf1).
                            	    12R             lsl.b   #1,d3             ; plane 3 bit -> carry
                            	    13R             roxl.b  #1,d1             ; ...into accumulator
                            	    14R             lsl.b   #1,d4             ; plane 2 bit
                            	    15R             roxl.b  #1,d1
                            	    16R             lsl.b   #1,d5             ; plane 0 bit (d5 loaded from plane_buf0)
                            	    17R             roxl.b  #1,d1
                            	    18R             lsl.b   #1,d6             ; plane 1 bit (d6 loaded from plane_buf1)
                            	    19R             roxl.b  #1,d1
                            	    20R         ENDR
                            	     1R             ; Verified bit order (traced by hand through the 9-bit
                            	     2R             ; roxl.b rotate-through-extend ring across all 8 steps that
                            	     3R             ; build one output byte -- see the equivalent derivation in
                            	     4R             ; md_tile_codec.py's module docstring for the full working):
