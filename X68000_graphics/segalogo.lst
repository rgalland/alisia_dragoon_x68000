                            	    42:     include "inc/gfx/palettes.i"

Source: "inc/gfx/palettes.i"
                            	     1: ; ==========================================================
                            	     2: ; Palette macros
                            	     3: ; ==========================================================
                            	     4: ;MDCOLOR MACRO b,g,r
                            	     5: MDCOLOR MACRO
                            	     6:     dc.w ((\1)<<7)|((\2)<<4)|((\3)<<1)
                            	     7: ENDM
                            	     8: 
                            	     9: 
                            	    10: ; DEC_N_COLOURS_TO_TARGET _target_pal _src_pal _n_colours (a2=_target_pal, a3=_src_pal d4=(_n_colours-1)
                            	    11: DEC_N_COLOURS_TO_TARGET MACRO
                            	    12:     INLINE
                            	    13:     lea         (\2),a3
                            	    14:     lea         (\1),a2
                            	    15:     moveq       #(\3-1),d4
                            	    16:     .loop_n_times:
                            	    17:         move.b      (a3),d0
                            	    18:         cmp.b       (a2)+,d3
                            	    19:         bcs.b       .save_b
                            	    20:         subq.b      #$2,d0
                            	    21:     .save_b:
                            	    22:         move.b      d0,(a3)+
                            	    23:         move.b      (a3),d0
                            	    24:         move.b      d0,d1
                            	    25:         andi.b      #$e0,d0
                            	    26:         andi.b      #$0e,d1
                            	    27:         move.b      (a2),d2
                            	    28:         lsr.b       #$4,d2
                            	    29:         cmp.b       d2,d3
                            	    30:         bcs.b       .save_g
                            	    31:         subi.b      #$20,d0
                            	    32:     .save_g:
                            	    33:         move.b      (a2)+,d2
                            	    34:         andi.b      #$0e,d2
                            	    35:         cmp.b       d2,d3
                            	    36:         bcs.b       .save_r
                            	    37:         subq.b      #$2,d1
                            	    38:     .save_r:
                            	    39:         or.b        d1,d0
                            	    40:         move.b      d0,(a3)+
                            	    41:         dbf         d4,.loop_n_times
                            	    42:     EINLINE
                            	    43:     ENDM
                            	    44: 
                            	    45: ; DEC_N_COLOURS _src_pal _decount_reg _n_colours (_target_pal is an address reg, _decount_reg=(_n_colours-1)
                            	    46: DEC_N_COLOURS MACRO
                            	    47:     INLINE
                            	    48:     moveq       #(\3-1),\2      ; will loop 16 times (32 bytes modified in total)
                            	    49:     .loop_n_times:
                            	    50:         move.b      (\1),d0
                            	    51:         beq.b       .save_b
                            	    52:         subq.b      #$2,d0      ; d0=d0-2
                            	    53:     .save_b:
                            	    54:         move.b      d0,(\1)+    ; save it back
                            	    55:         move.b      (\1),d0
                            	    56:         move.b      d0,d1
                            	    57:         andi.b      #$0e,d1      ; d1=d0&$0e
                            	    58:         andi.b      #$e0,d0     ; d0=d0&$e0
                            	    59:         beq.b       .save_g
                            	    60:         subi.b      #$20,d0     ; d0=d0-$20
                            	    61:     .save_g:
                            	    62:         tst.b       d1
                            	    63:         beq.b       .save_r
                            	    64:         subq.w      #$2,d1      ; d1=d1-2
                            	    65:     .save_r:
                            	    66:         or.b        d1,d0       ; put 2 nibbles into d0
                            	    67:         move.b      d0,(\1)+    ; and save back
                            	    68:         dbf         \2,.loop_n_times
                            	    69:     EINLINE
                            	    70:     ENDM
                            	    71: 

Source: "sega_logo_x68k.s"
                            	    43: 
                            	    44:     text
                            	    45:     even
                            	    46: 
                            	    47: ; =============================================================================
                            	    48: ; display_sega_logo
                            	    49: ; Equivalent of the MD display_sega_logo routine (alisia_dis.asm ~L700-757)
                            	    50: ; =============================================================================
                            	    51: display_sega_logo:
                            	    52:     DOS_SUPER
00:00000000 48780000        	     1M     pea     0
                            	     2M     DOS     _SUPER
00:00000004 FF20            	     1M     dc.w    __DOS__SUPER
00:00000006 588F            	     3M     addq.l  #4,sp
00:00000008 610005CE        	    53:     bsr.w   init_crtc_320x224      ; MD: init_vdp (register setup half only —
                            	    54:                                     ; the MD's vram_fill_dma VRAM-zero call has
                            	    55:                                     ; no direct analogue here; GVRAM is cleared
                            	    56:                                     ; explicitly below instead)
                            	    57: 
                            	    58:     ; --- Clear graphic layer 0 to colour index 0 ---
                            	    59:     ; MD: reset_vram_bg1_and_2_tilemaps filled BOTH nametables with a blank
                            	    60:     ; tile ($400) under DISABLE_INTERRUPTS, because the MD VDP would show
                            	    61:     ; garbage tile data otherwise. On X68000 there's no nametable to
                            	    62:     ; initialise — the equivalent guarantee is just: the framebuffer starts
                            	    63:     ; at colour index 0 everywhere until we blit real pixels over it.
                            	    64:     CLEAR_GVRAM_L0  0
00:0000000C 41F900C00000    	     1M     lea     (GVRAM_PAGE0),a0
00:00000012 203C0003FFFF    	     2M     move.l  #(GVRAM_PAGE_SIZE/2)-1,d0   ; divide by 2 as words will be processed
00:00000018 7200            	     3M     moveq   #$0,d1    
00:0000001A 123C0000        	     4M     move.b  #0,d1
                            	     5M .cgl0_000007:
00:0000001E 30C1            	     6M     move.w  d1,(a0)+
00:00000020 51C8FFFC        	     7M     dbf     d0,.cgl0_000007
                            	    65:     CLEAR_GVRAM_L1  0
00:00000024 41F900D00000    	     1M     lea     (GVRAM_PAGE2),a0
00:0000002A 203C0003FFFF    	     2M     move.l  #(GVRAM_PAGE_SIZE/2)-1,d0
00:00000030 7200            	     3M     moveq   #$0,d1    
00:00000032 123C0000        	     4M     move.b  #0,d1
                            	     5M .cgl1_000008:
00:00000036 30C1            	     6M     move.w  d1,(a0)+
00:00000038 51C8FFFC        	     7M     dbf     d0,.cgl1_000008
                            	    66:     CLEAR_GPAL
00:0000003C 41F900E82000    	     1M     lea     (GPAL_BASE),a0
00:00000042 303C00FF        	     2M     move.w  #(GPAL_COUNT-1),d0
                            	     3M .cgp_loop_000009:
00:00000046 4258            	     4M     clr.w   (a0)+
00:00000048 51C8FFFC        	     5M     dbf     d0,.cgp_loop_000009
                            	    67:     CLEAR_SPAL
00:0000004C 41F900E82200    	     1M     lea     (SPAL_BASE),a0
00:00000052 303C00FF        	     2M     move.w  #(SPAL_COUNT-1),d0
                            	     3M .csp_loop_000010:
00:00000056 4258            	     4M     clr.w   (a0)+
00:00000058 51C8FFFC        	     5M     dbf     d0,.csp_loop_000010
                            	    68: 
                            	    69:     ; clear bss variables
00:0000005C 61000708        	    70:     bsr     clear_bg_pal_ram
00:00000060 61000716        	    71:     bsr     clear_sp_pal_ram
                            	    72: 
                            	    73:     ; --- Clear graphic palette entries 0-15 (logo's palette block) ---
                            	    74:     ; MD: clear_palettes_0_to_3 + clear_palettes_4_to_7 zeroed all 8 CRAM
                            	    75:     ; palettes (4 words x 8 = 32 words). We only need entries 0-15 here,
                            	    76:     ; since the logo's 8bpp tile data only ever indexes 0-15 (see
                            	    77:     ; conversion note above) and nothing else uses GPAL 16-255 yet.
00:00000064 41F900E82000    	    78:     lea     (GPAL_BASE),a0
00:0000006A 700F            	    79:     moveq   #15,d0
                            	    80: .clear_gpal_loop:
00:0000006C 4258            	    81:     clr.w   (a0)+
00:0000006E 51C8FFFC        	    82:     dbf     d0,.clear_gpal_loop
                            	    83: 
                            	    84:     ; --- Upload and blit tile pixel data directly into place ---
                            	    85:     ; MD: two separate steps — (1) raw copy of all 49 tiles to VRAM address
                            	    86:     ; 0 as a flat blob, then (2) a 12x4 tilemap write that references tile
                            	    87:     ; indices 1-48 by number, landing them at nametable address $C61C
                            	    88:     ; (column 14, row 12 — see conversation notes for the derivation).
                            	    89:     ; X68000: no indirection needed — blit each tile's pixels straight to
                            	    90:     ; its final framebuffer position in one pass, in the same raster order
                            	    91:     ; the MD tilemap used (sega_logo_tilemap is a plain ascending sequence
                            	    92:     ; 1..48, no reordering or flip bits), so no tilemap table is needed at
                            	    93:     ; all on this side.
00:00000072 41F90000005E    	    94:     lea     (sega_logo_tiles_4bpp+MD_TILE_BYTES),a0   ; skip unused tile 0
00:00000078 7C03            	    95:     moveq   #3,d6                  ; 4 rows (was moveq #$3,d6 on MD)
00:0000007A 363C0060        	    96:     move.w  #LOGO_ORIGIN_Y,d3      ; current row's Y pixel position
                            	    97: .blit_row:
00:0000007E 7E0B            	    98:     moveq   #11,d7                 ; 12 columns (was moveq #$b,d5 on MD)
00:00000080 343C0070        	    99:     move.w  #(LOGO_ORIGIN_X),d2  ; current column's X pixel position in words
                            	   100: .blit_col:
                            	   101:     ; NOTE: GVRAM_ADDR_L0's doc comment (x68k_macros.i) claims it clobbers
                            	   102:     ; the Y register, but its actual body only writes the result register
                            	   103:     ; -- traced directly rather than trusting the comment, so no save/
                            	   104:     ; restore of d2/d3 is needed around this call.
                            	   105:     BLIT_TILE_L0 a0,d2,d3,a1        ; a0 auto-advances past this tile
                            	     1M     GVRAM_ADDR_L0 d2,d3,a1          ; calculate VRAM destination
00:00000084 3003            	     1M     move.w   d3,d0
00:00000086 C0FC0400        	     2M     mulu.w   #GVRAM_WIDTH,d0
00:0000008A 43F900C00000    	     3M     lea      (GVRAM_PAGE0),a1
00:00000090 D3C0            	     4M     adda.l   d0,a1
00:00000092 D2C2            	     5M     adda.w   d2,a1     
00:00000094 D2C2            	     6M     adda.w   d2,a1  ; add twice to point at words
00:00000096 323C0007        	     2M     move.w  #(TILE_W-1),d1
                            	     3M     .bt_row_000011:
00:0000009A 2818            	     4M         move.l  (a0)+,d4                ; copy 8 pixels
00:0000009C 303C0007        	     5M         move.w  #(TILE_H-1),d0          
                            	     6M         .bt_col_000011:
00:000000A0 E99C            	     7M             rol.l   #$4,d4                  ; shift for next nibble    
00:000000A2 3A04            	     8M             move.w  d4,d5                   ; copy word as only bottom nibble is used
00:000000A4 CA7C000F        	     9M             and.w   #$000f,d5               ; TODO as a pallet nibble to bits 7-4
00:000000A8 32C5            	    10M             move.w  d5,(a1)+
00:000000AA 51C8FFF4        	    11M             dbf     d0,.bt_col_000011
00:000000AE 43E903F0        	    12M         lea     (GVRAM_WIDTH-TILE_W*2,a1),a1   ; advance destination by one row stride
00:000000B2 51C9FFE6        	    13M         dbf     d1,.bt_row_000011
00:000000B6 5042            	   106:     addq.w  #(TILE_W),d2
00:000000B8 51CFFFCA        	   107:     dbf     d7,.blit_col
00:000000BC 5043            	   108:     addq.w  #TILE_H,d3
00:000000BE 51CEFFBE        	   109:     dbf     d6,.blit_row
                            	   110: 
                            	   111:     ; --- Convert the MD colour-cycle table once, up front ---
                            	   112:     ; See convert_md_colours_to_x68k below. Keeping the MD table verbatim
                            	   113:     ; as the single source of truth (rather than hand-transcribing a
                            	   114:     ; pre-converted table) means any future correction to the original
                            	   115:     ; data doesn't need a parallel manual re-conversion.
                            	   116:     CONVERT_MD_TO_X68K_COLOURS sega_logo_colours_md, sega_logo_colours_x68k, 30
00:000000C2 48E7F0C0        	     1M     movem.l d0-d3/a0-a1,-(sp)
