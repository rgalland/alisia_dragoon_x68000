                            	   376: ; =============================================================================
                            	   377: ; Scratch buffers -- one 256-byte window per bitplane, reused across
                            	   378: ; batches. Not re-entrant; fine for load-time-only use.
                            	   379: ; =============================================================================
                            	   380:     bss
                            	   381:     even
01:00000000 00              	   382: plane_buf0:     ds.b    256
01:00000001 *
01:00000100 00              	   383: plane_buf1:     ds.b    256
01:00000101 *
01:00000200 00              	   384: plane_buf2:     ds.b    256
01:00000201 *
01:00000300 00              	   385: plane_buf3:     ds.b    256
01:00000301 *
