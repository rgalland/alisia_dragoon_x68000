                            	   169: ; =============================================================================
                            	   170: ; init_crtc_320x224
                            	   171: ; Programs the CRTC + video controller for the 320x224 15kHz mode derived
                            	   172: ; in x68k_hw.i, and selects 256-colour/512x512 graphic mode.
                            	   173: ; =============================================================================
                            	   174: init_crtc_320x224:
00:000005D8 41F900E80000    	   175:     lea     (CRTC_R00),a0
00:000005DE 30BC004C        	   176:     move.w  #CRTC_320_R00,(a0)
00:000005E2 317C00100002    	   177:     move.w  #CRTC_320_R01,(2,a0)
00:000005E8 317C001A0004    	   178:     move.w  #CRTC_320_R02,(4,a0)
00:000005EE 317C00450006    	   179:     move.w  #CRTC_320_R03,(6,a0)
00:000005F4 317C01030008    	   180:     move.w  #CRTC_320_R04,(8,a0)
00:000005FA 317C0002000A    	   181:     move.w  #CRTC_320_R05,(10,a0)
00:00000600 317C0018000C    	   182:     move.w  #CRTC_320_R06,(12,a0)
00:00000606 317C00F8000E    	   183:     move.w  #CRTC_320_R07,(14,a0)
00:0000060C 317C00240010    	   184:     move.w  #CRTC_320_R08,(16,a0)
00:00000612 33FC000100E80028	   185:     move.w  #CRTC_320_R20,(CRTC_R20)
00:0000061A 33FC003300E8002A	   186:     move.w  #CRTC_320_R21,(CRTC_R21)
                            	   187: 
00:00000622 33FC000100E82400	   188:     move.w  #VC_R0_GAME,(VC_R0)     ; 512x512 GVRAM + 256-colour
00:0000062A 33FC02E400E82500	   189:     move.w  #VC_R1_GAME,(VC_R1)     ; layer priority (sprite/text/graphic)
00:00000632 33FC000000E82600	   190:     move.w  #0,(VC_R2)
                            	   191: 
00:0000063A 33FC000000EB0800	   192:     move.w      #$0000,BG0_HSCROLL
00:00000642 33FC000000EB0802	   193:     move.w      #$0000,BG0_VSCROLL
00:0000064A 33FC000000EB0804	   194:     move.w      #$0000,BG1_HSCROLL
00:00000652 33FC000000EB0806	   195:     move.w      #$0000,BG1_VSCROLL
00:0000065A 33FC021200EB0808	   196:     move.w      #$0212,BG_CTRL
00:00000662 33FC00FF00EB080A	   197:     move.w      #$00ff,BG_H_TOTAL
00:0000066A 33FC000F00EB080C	   198:     move.w      #$000f,BG_H_POS
00:00000672 33FC003100EB080E	   199:     move.w      #$0031,BG_V_POS
00:0000067A 33FC000000EB0810	   200:     move.w      #$0000,BG_RES
                            	   201: 
                            	   202:     ; NOTE: VC_R2 (layer on/off) deliberately NOT set here — display_sega_logo
                            	   203:     ; sets it explicitly after the framebuffer/palette are ready, to avoid
                            	   204:     ; a frame of garbage on screen (mirrors the MD's own DISABLE_INTERRUPTS-
                            	   205:     ; wrapped setup-before-enable ordering).
00:00000682 4E75            	   206:     rts
                            	   207: 
