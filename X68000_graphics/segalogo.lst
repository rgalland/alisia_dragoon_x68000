Source: "inc/gfx/palettes.i"
                            	     1: ; ==========================================================
                            	     2: ; Palette macros
                            	     3: ; ==========================================================
                            	     4: ;MDCOLOR MACRO b,g,r
                            	     5: MDCOLOR MACRO
                            	     6:     dc.w ((\1)<<7)|((\2)<<4)|((\3)<<1)
                            	     7: ENDM
                            	     8: 
                            	     9: 
                            	    10: ; DEC_N_COLOURS_TO_TARGET _target_pal _src_pal _n_colours (a2=_target_pal, a3=_src_pal d4=(_n_colours-1)
                            	    11: DEC_N_COLOURS_TO_TARGET MACRO
                            	    12:     INLINE
                            	    13:     lea         (\2),a3
                            	    14:     lea         (\1),a2
                            	    15:     moveq       #(\3-1),d4
                            	    16:     .loop_n_times:
                            	    17:         move.b      (a3),d0
                            	    18:         cmp.b       (a2)+,d3
                            	    19:         bcs.b       .save_b
                            	    20:         subq.b      #$2,d0
                            	    21:     .save_b:
                            	    22:         move.b      d0,(a3)+
                            	    23:         move.b      (a3),d0
                            	    24:         move.b      d0,d1
                            	    25:         andi.b      #$e0,d0
                            	    26:         andi.b      #$0e,d1
                            	    27:         move.b      (a2),d2
                            	    28:         lsr.b       #$4,d2
                            	    29:         cmp.b       d2,d3
                            	    30:         bcs.b       .save_g
                            	    31:         subi.b      #$20,d0
                            	    32:     .save_g:
                            	    33:         move.b      (a2)+,d2
                            	    34:         andi.b      #$0e,d2
                            	    35:         cmp.b       d2,d3
                            	    36:         bcs.b       .save_r
                            	    37:         subq.b      #$2,d1
                            	    38:     .save_r:
                            	    39:         or.b        d1,d0
                            	    40:         move.b      d0,(a3)+
                            	    41:         dbf         d4,.loop_n_times
                            	    42:     EINLINE
                            	    43:     ENDM
                            	    44: 
                            	    45: ; DEC_N_COLOURS _src_pal _decount_reg _n_colours (_target_pal is an address reg, _decount_reg=(_n_colours-1)
                            	    46: DEC_N_COLOURS MACRO
                            	    47:     INLINE
                            	    48:     moveq       #(\3-1),\2      ; will loop 16 times (32 bytes modified in total)
                            	    49:     .loop_n_times:
                            	    50:         move.b      (\1),d0
                            	    51:         beq.b       .save_b
                            	    52:         subq.b      #$2,d0      ; d0=d0-2
                            	    53:     .save_b:
                            	    54:         move.b      d0,(\1)+    ; save it back
                            	    55:         move.b      (\1),d0
                            	    56:         move.b      d0,d1
                            	    57:         andi.b      #$0e,d1      ; d1=d0&$0e
                            	    58:         andi.b      #$e0,d0     ; d0=d0&$e0
                            	    59:         beq.b       .save_g
                            	    60:         subi.b      #$20,d0     ; d0=d0-$20
                            	    61:     .save_g:
                            	    62:         tst.b       d1
                            	    63:         beq.b       .save_r
                            	    64:         subq.w      #$2,d1      ; d1=d1-2
                            	    65:     .save_r:
                            	    66:         or.b        d1,d0       ; put 2 nibbles into d0
                            	    67:         move.b      d0,(\1)+    ; and save back
                            	    68:         dbf         \2,.loop_n_times
                            	    69:     EINLINE
                            	    70:     ENDM
                            	    71: 

