Source: "tile_decompress_x68k.s"
                            	     1: ; =============================================================================
                            	     2: ; tile_decompress_x68k.s — Standalone bitplane-RLE tile decompressor
                            	     3: ;
                            	     4: ; Extracted from write_tileset (alisia_dis.asm ~L16962-17222) and its
                            	     5: ; sub-routines .decompress_planar_data_streams / .decompress_plane /
                            	     6: ; .planar_to_packed_conv.
                            	     7: ;
                            	     8: ; IMPORTANT CONTEXT: the Mega Drive's main CPU is a 68000, same as the
                            	     9: ; X68000 -- this is NOT an instruction-set port like the Z80 sound driver
                            	    10: ; was. The algorithm below is untouched 68000 logic. The only things
                            	    11: ; removed are VDP-specific: the original write_tileset supported two output
                            	    12: ; modes selected by a runtime flag (d1 param) --
                            	    13: ;   flag=1 (what the MD actually used): set up a VDP VRAM write address,
                            	    14: ;           then stream each decoded word straight to VDP_DATA
                            	    15: ;   flag=0 (only path we need): write decoded words to a RAM pointer
                            	    16: ; This file keeps ONLY the flag=0 / RAM-output path, and drops the
                            	    17: ; VDP_CTRL address-setup preamble entirely, since VRAM isn't touched here
                            	    18: ; at all -- this routine's whole job is decompress-to-RAM. The separate
                            	    19: ; RAM-to-GVRAM blit (via the tilemap) is a distinct later step.
                            	    20: ;
                            	    21: ; DISABLE_INTERRUPTS/ENABLE_INTERRUPTS from the original are also dropped:
                            	    22: ; on the MD they guarded against an interrupt handler touching VDP_CTRL
                            	    23: ; mid-stream and corrupting the VRAM auto-increment address. Since this
                            	    24: ; routine never touches hardware -- it only writes to a linear RAM buffer
                            	    25: ; -- there's no equivalent hazard here.
                            	    26: ;
                            	    27: ; =============================================================================
                            	    28: ; Compressed data format (verified against write_tileset, not guessed):
                            	    29: ;
                            	    30: ;   header+$00..$01  tile count (big-endian word)
                            	    31: ;   header+$02..$09  8-byte "dictionary" -- used by the $00-$1F opcode class
                            	    32: ;   header+$0A..$0B  offset from header to plane 1's stream (big-endian word)
                            	    33: ;   header+$0C..$0D  offset from header to plane 2's stream
                            	    34: ;   header+$0E..$0F  offset from header to plane 3's stream
                            	    35: ;   header+$10       plane 0's stream starts here
                            	    36: ;
                            	    37: ; Each of the 4 streams is independently RLE-compressed (bitplane
                            	    38: ; separation: pixel N's 4-bit palette index is split one bit per plane,
                            	    39: ; each plane RLE'd separately since bitplanes have much longer runs than
                            	    40: ; interleaved 4bpp pixel data).
                            	    41: ;
                            	    42: ; Per-plane RLE opcode table (dispatched on the top bits of each control
                            	    43: ; byte read from the stream):
                            	    44: ;
                            	    45: ;   $00-$1F  write dictionary[(byte>>2)&7] TWICE, then copy (byte&3)
                            	    46: ;            (0-3) literal bytes
                            	    47: ;   $20-$2F  write ((byte>>2)&3)+2 (2-5) copies of $00, then copy (byte&3)
                            	    48: ;            (0-3) literal bytes
                            	    49: ;   $30-$3F  same as $20-$2F but with $FF instead of $00
                            	    50: ;   $40-$5F  write (byte&$1F)+6 (6-37) copies of $00, no literal tail
                            	    51: ;   $60-$7F  same as $40-$5F but with $FF
                            	    52: ;   $80-$BF  read one byte V from the stream; write ((byte>>2)&$F)+2
                            	    53: ;            (2-17) copies of V, then copy (byte&3) (0-3) literal bytes
                            	    54: ;   $C0-$FF  copy (byte&$3F)+1 (1-64) literal bytes verbatim, no run
                            	    55: ;
                            	    56: ; NOTE on the ranges above: the four run-count opcodes ($20-$7F, $80-$BF)
                            	    57: ; feed their computed count into a dbf loop, which executes (count+1)
                            	    58: ; times on a 68000 -- three of these four opcode classes don't pre-
                            	    59: ; compensate for that extra iteration the way the tail-copy loops and
                            	    60: ; the $C0-$FF literal opcode do (both have an explicit subq.w #1 right
                            	    61: ; before their own dbf). The ranges listed here already account for
                            	    62: ; that; the inline code comments near each opcode below note the raw
                            	    63: ; field value separately from the true executed range, since they
                            	    64: ; differ by one. This was wrong in an earlier revision (both here and
                            	    65: ; in the inline comments) until cross-checked against real compressed
                            	    66: ; game data (block39.bin) failing to decode -- a synthetic round-trip
                            	    67: ; self-test alone couldn't catch it, since a matching encoder/decoder
                            	    68: ; pair sharing the same wrong assumption still agree with each other.
                            	    69: ;
                            	    70: ; Reassembly: once a batch of up to 256 bytes/plane is decoded into the 4
                            	    71: ; scratch buffers below, each SET of 1 byte from every one of the 4 planes
                            	    72: ; (8 bits = 8 pixels' worth of that bit position) is bit-interleaved back
                            	    73: ; into 8 pixels of standard packed 4bpp tile data (4 output bytes) -- one
                            	    74: ; bit shifted out of each plane register per pixel nibble, 4 shifts per
                            	    75: ; pixel, rotated into an accumulator.
                            	    76: ;
                            	    77: ; Output size check (confirms the header's tile-count field is read
                            	    78: ; correctly): total_bytes_per_plane = tile_count * 8, matching exactly
                            	    79: ; 8 rows/tile x 1 byte/row/plane (8 pixels/row = 8 bits = 1 byte per
                            	    80: ; bitplane per tile row).
                            	    81: ; =============================================================================
                            	    82: 
                            	    83:     text
                            	    84:     even
                            	    85: 
                            	    86: ; =============================================================================
                            	    87: ; decompress_tileset
                            	    88: ; Decode one full compressed tileset block into packed 4bpp tile data.
                            	    89: ;
                            	    90: ; In:  a0 = pointer to compressed data (header, as described above)
                            	    91: ;      a1 = pointer to destination RAM buffer for decoded packed 4bpp
                            	    92: ;           tile data (caller must size this: tile_count * 32 bytes,
                            	    93: ;           since each 8x8 4bpp tile is 32 bytes packed)
                            	    94: ; Out: a1 = advanced past the last byte written (== start + total size)
                            	    95: ; Clobbers: d0-d7, a0-a6
                            	    96: ; =============================================================================
                            	    97: decompress_tileset:
00:0000081A 48E7FFFE        	    98:     movem.l a6-a0/d7-d0,-(sp)
                            	    99: 
                            	   100:     ; --- Read tile count, compute total bytes-per-plane to decode ---
00:0000081E 1210            	   101:     move.b  (a0),d1                ; header+$00 = count MSB
00:00000820 E149            	   102:     lsl.w   #8,d1
00:00000822 12280001        	   103:     move.b  (1,a0),d1               ; header+$01 = count LSB
00:00000826 C2FC0008        	   104:     mulu.w  #8,d1                   ; d1 = tile_count * 8 (bytes/plane total)
                            	   105: 
                            	   106:     ; --- Resolve the 4 plane stream start pointers ---
00:0000082A 2648            	   107:     movea.l a0,a3
00:0000082C 2848            	   108:     movea.l a0,a4
00:0000082E 2A48            	   109:     movea.l a0,a5
00:00000830 2C48            	   110:     movea.l a0,a6
00:00000832 7E00            	   111:     clr.l   d7
00:00000834 47EB0010        	   112:     adda.w  #$10,a3                 ; plane 0 stream starts right after header
                            	   113: 
00:00000838 1E28000A        	   114:     move.b  ($a,a0),d7               ; plane 1 offset MSB
00:0000083C E14F            	   115:     lsl.w   #8,d7
00:0000083E 1E28000B        	   116:     move.b  ($b,a0),d7               ; plane 1 offset LSB
00:00000842 D9C7            	   117:     adda.l  d7,a4
                            	   118: 
00:00000844 1E28000C        	   119:     move.b  ($c,a0),d7               ; plane 2 offset MSB
00:00000848 E14F            	   120:     lsl.w   #8,d7
00:0000084A 1E28000D        	   121:     move.b  ($d,a0),d7               ; plane 2 offset LSB
00:0000084E DBC7            	   122:     adda.l  d7,a5
                            	   123: 
00:00000850 1E28000E        	   124:     move.b  ($e,a0),d7               ; plane 3 offset MSB
00:00000854 E14F            	   125:     lsl.w   #8,d7
00:00000856 1E28000F        	   126:     move.b  ($f,a0),d7               ; plane 3 offset LSB
00:0000085A DDC7            	   127:     adda.l  d7,a6
                            	   128: 
                            	   129: .decode_loop:
00:0000085C 610E            	   130:     bsr.b   decompress_planar_data_streams
00:0000085E 61000142        	   131:     bsr.w   planar_to_packed_conv
00:00000862 4A41            	   132:     tst.w   d1
00:00000864 66F6            	   133:     bne.b   .decode_loop
                            	   134: 
00:00000866 4CDF7FFF        	   135:     movem.l (sp)+,d0-d7/a0-a6
00:0000086A 4E75            	   136:     rts
                            	   137: 
                            	   138: 
                            	   139: ; =============================================================================
                            	   140: ; decompress_planar_data_streams
                            	   141: ; Decode up to 256 bytes from EACH of the 4 plane streams into the 4
                            	   142: ; scratch buffers below. d1 = total bytes/plane still remaining overall
                            	   143: ; (decremented here); d2 = bytes decoded THIS batch (fed to
                            	   144: ; planar_to_packed_conv immediately after).
                            	   145: ; a3-a6 = current read position in each of the 4 plane streams (advanced
                            	   146: ; in place, ready for the next batch).
                            	   147: ; =============================================================================
                            	   148: decompress_planar_data_streams:
00:0000086C 4A41            	   149:     tst.w   d1
00:0000086E 67000046        	   150:     beq.w   .leave
00:00000872 2F09            	   151:     move.l  a1,-(sp)
00:00000874 343C0100        	   152:     move.w  #$100,d2
00:00000878 B242            	   153:     cmp.w   d2,d1
00:0000087A 6504            	   154:     bcs.b   .less_than_100h
00:0000087C 9242            	   155:     sub.w   d2,d1                   ; more than 256 left -- take a full batch
00:0000087E 6004            	   156:     bra.b   .decompress_all_planes
                            	   157: .less_than_100h:
00:00000880 3401            	   158:     move.w  d1,d2                   ; final partial batch
00:00000882 4241            	   159:     clr.w   d1
                            	   160: .decompress_all_planes:
00:00000884 224B            	   161:     movea.l a3,a1
00:00000886 45F900000000    	   162:     lea     (plane_buf0),a2
00:0000088C 612A            	   163:     bsr.b   decompress_plane
00:0000088E 2649            	   164:     movea.l a1,a3
                            	   165: 
00:00000890 224C            	   166:     movea.l a4,a1
00:00000892 45F900000100    	   167:     lea     (plane_buf1),a2
00:00000898 611E            	   168:     bsr.b   decompress_plane
00:0000089A 2849            	   169:     movea.l a1,a4
                            	   170: 
00:0000089C 224D            	   171:     movea.l a5,a1
00:0000089E 45F900000200    	   172:     lea     (plane_buf2),a2
00:000008A4 6112            	   173:     bsr.b   decompress_plane
00:000008A6 2A49            	   174:     movea.l a1,a5
                            	   175: 
00:000008A8 224E            	   176:     movea.l a6,a1
00:000008AA 45F900000300    	   177:     lea     (plane_buf3),a2
00:000008B0 6106            	   178:     bsr.b   decompress_plane
00:000008B2 2C49            	   179:     movea.l a1,a6
                            	   180: 
00:000008B4 225F            	   181:     movea.l (sp)+,a1
                            	   182: .leave:
00:000008B6 4E75            	   183:     rts
                            	   184: 
                            	   185: 
                            	   186: ; =============================================================================
                            	   187: ; decompress_plane
                            	   188: ; Decode one plane's RLE stream. a1 = stream read pointer (advanced),
                            	   189: ; a2 = scratch output buffer (advanced), d2 = bytes to produce.
                            	   190: ; a0 must still hold the compressed-block HEADER pointer (used for the
                            	   191: ; $00-$1F opcode's dictionary lookup at header+2..+9) -- this is why
                            	   192: ; decompress_tileset never repurposes a0 for anything else.
                            	   193: ; Clobbers: d3-d6, a1, a2
                            	   194: ; =============================================================================
                            	   195: decompress_plane:
00:000008B8 3C02            	   196:     move.w  d2,d6                   ; d6 = remaining output bytes this batch
                            	   197: .next_op:
00:000008BA 4A46            	   198:     tst.w   d6
00:000008BC 670000E2        	   199:     beq.w   .done
00:000008C0 1619            	   200:     move.b  (a1)+,d3                ; d3 = control byte
00:000008C2 1803            	   201:     move.b  d3,d4
00:000008C4 020400F0        	   202:     andi.b  #$f0,d4
00:000008C8 0C040030        	   203:     cmpi.b  #$30,d4
00:000008CC 6750            	   204:     beq.b   .op_30_ff_short
00:000008CE 0C040020        	   205:     cmpi.b  #$20,d4
00:000008D2 6746            	   206:     beq.b   .op_20_00_short
00:000008D4 020400E0        	   207:     andi.b  #$e0,d4
00:000008D8 0C040060        	   208:     cmpi.b  #$60,d4
00:000008DC 676E            	   209:     beq.b   .op_60_ff_long
00:000008DE 0C040040        	   210:     cmpi.b  #$40,d4
00:000008E2 6764            	   211:     beq.b   .op_40_00_long
00:000008E4 020400C0        	   212:     andi.b  #$c0,d4
00:000008E8 0C0400C0        	   213:     cmpi.b  #$c0,d4
00:000008EC 670000A0        	   214:     beq.w   .op_c0_literal
00:000008F0 0C040080        	   215:     cmpi.b  #$80,d4
00:000008F4 676C            	   216:     beq.b   .op_80_byte_run
                            	   217:     ; --- $00-$1F: dictionary byte x2, then (d3&3) literal bytes ---
00:000008F6 1803            	   218:     move.b  d3,d4
00:000008F8 0244001C        	   219:     andi.w  #$1c,d4
00:000008FC E44C            	   220:     lsr.w   #2,d4                    ; d4 = dictionary index 0-7
00:000008FE 1A304002        	   221:     move.b  ($2,a0,d4.w),d5           ; d5 = header+2+d4 (the dictionary byte)
00:00000902 5546            	   222:     subq.w  #2,d6
00:00000904 14C5            	   223:     move.b  d5,(a2)+
00:00000906 14C5            	   224:     move.b  d5,(a2)+
00:00000908 02430003        	   225:     andi.w  #3,d3
00:0000090C 67AC            	   226:     beq    .next_op
00:0000090E 9C43            	   227:     sub.w   d3,d6
00:00000910 5343            	   228:     subq.w  #1,d3
                            	   229: .op00_tail:
00:00000912 14D9            	   230:     move.b  (a1)+,(a2)+
00:00000914 51CBFFFC        	   231:     dbf     d3,.op00_tail
00:00000918 60A0            	   232:     bra     .next_op
                            	   233: 
                            	   234: .op_20_00_short:
00:0000091A 7A00            	   235:     moveq   #0,d5
00:0000091C 6002            	   236:     bra.b   .op_20_30_common
                            	   237: .op_30_ff_short:
00:0000091E 7AFF            	   238:     moveq   #-1,d5
                            	   239: .op_20_30_common:
00:00000920 1803            	   240:     move.b  d3,d4
00:00000922 0243000C        	   241:     andi.w  #$c,d3
00:00000926 E44B            	   242:     lsr.w   #2,d3
00:00000928 5243            	   243:     addq.w  #1,d3                    ; d3 = 1-4 here, but dbf below executes
                            	   244:                                      ; (d3+1) times -- true run length is 2-5.
                            	   245:                                      ; This matches real MD behaviour exactly
                            	   246:                                      ; (same dbf semantics on both CPUs); only
                            	   247:                                      ; get this wrong if you're computing the
                            	   248:                                      ; range from d3's value instead of from
                            	   249:                                      ; what the dbf loop actually executes.
00:0000092A 9C43            	   250:     sub.w   d3,d6
00:0000092C 5346            	   251:     subq.w  #1,d6
                            	   252: .op2030_run:
00:0000092E 14C5            	   253:     move.b  d5,(a2)+
00:00000930 51CBFFFC        	   254:     dbf     d3,.op2030_run
00:00000934 02440003        	   255:     andi.w  #3,d4                    ; literal tail count 0-3
00:00000938 6780            	   256:     beq     .next_op
00:0000093A 9C44            	   257:     sub.w   d4,d6
00:0000093C 5344            	   258:     subq.w  #1,d4
                            	   259: .op2030_tail:
00:0000093E 14D9            	   260:     move.b  (a1)+,(a2)+
00:00000940 51CCFFFC        	   261:     dbf     d4,.op2030_tail
00:00000944 6000FF74        	   262:     bra     .next_op
                            	   263: 
                            	   264: .op_40_00_long:
00:00000948 7A00            	   265:     moveq   #0,d5
00:0000094A 6002            	   266:     bra.b   .op_40_60_common
                            	   267: .op_60_ff_long:
00:0000094C 7AFF            	   268:     moveq   #-1,d5
                            	   269: .op_40_60_common:
00:0000094E 0243001F        	   270:     andi.w  #$1f,d3
00:00000952 5A43            	   271:     addq.w  #5,d3                    ; d3 = 5-36 here, but dbf below executes
                            	   272:                                      ; (d3+1) times -- true run length is 6-37.
00:00000954 9C43            	   273:     sub.w   d3,d6
00:00000956 5346            	   274:     subq.w  #1,d6
                            	   275: .op4060_run:
00:00000958 14C5            	   276:     move.b  d5,(a2)+
00:0000095A 51CBFFFC        	   277:     dbf     d3,.op4060_run
00:0000095E 6000FF5A        	   278:     bra     .next_op
                            	   279: 
                            	   280: .op_80_byte_run:
00:00000962 1803            	   281:     move.b  d3,d4
