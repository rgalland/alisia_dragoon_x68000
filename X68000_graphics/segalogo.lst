01:0000041C 47F9000093AA    	    12:     lea     (intro_credits_bg2_tm),a3  ; ($40+$c0/2)*$13 tile sin total (160x24)
01:00000422 363C0020        	    13:     move.w  #$20,d3   ; current row's Y pixel position in VRAM
01:00000426 7C13            	    14:     moveq   #(20-1),d6 ; intro credits tilemap is 20 rows high
                            	    15:     .blit_intro_credits_row:
01:00000428 343C0000        	    16:         move.w  #0,d2  ; current column's X pixel position in words
01:0000042C 7E3F            	    17:         moveq   #(64-1),d7  ; 64 tiles to fit the whole VRAM width (8x64=512px)
                            	    18:         .blit_intro_credits_col:   ; 64 columns to include 24 columns not yet visible on screen
01:0000042E 301B            	    19:             move.w  (a3)+,d0
01:00000430 EB48            	    20:             lsl.w   #5,d0      ; tm index shifted to address 64 KB space
01:00000432 43F90000C05A    	    21:             lea     scratch_memory,a1       ; point at start of scratch memory again
01:00000438 D2C0            	    22:             adda.w  d0,a1
