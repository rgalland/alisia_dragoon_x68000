                            	     4:     ; load intro credits to PAGE1
01:00000400 41FA0BB0        	     5:     lea     intro_credits_ts_p1,a0
01:00000404 43F90000C05A    	     6:     lea     scratch_memory,a1
01:0000040A 6100081A        	     7:     bsr     decompress_tileset
01:0000040E 41FA4EEC        	     8:     lea     intro_credits_ts_p2,a0
01:00000412 43F90001205A    	     9:     lea     scratch_memory+$6000,a1
