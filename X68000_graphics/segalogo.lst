                            	   209: ; =============================================================================
                            	   210: ; convert_md_colours_to_x68k
                            	   211: ; One-time conversion of the verbatim MD colour-cycle table into X68000
                            	   212: ; GPAL G5-R5-B5 format, into a RAM buffer.
                            	   213: ;
                            	   214: ; MD CRAM word format:   0000 BBB0 GGG0 RRR0 (3-bit channels, LSB unused)
                            	   215: ; X68k GPAL word format: GGGG GRRR RRBB BBBI (5-bit channels + intensity)
                            	   216: ;
                            	   217: ; Not used - Per-channel scaling uses md3_to_x68k5 (8-entry table, values 0-7 -> 0-31,
                            	   218: ; rounded to nearest: v*31/7). See x68k_hw.i's MD-to-X68k conversion note.
                            	   219: ; =============================================================================
                            	   220: convert_md_colours_to_x68k:
                            	   221: .convert_loop:
00:00000684 7400            	   222:     moveq   #$0,d2                  ; will store x68000 colour result
00:00000686 3018            	   223:     move.w  (a0)+,d0                ; d0 = MD colour word
                            	   224:     ; blue: bits 3-1
00:00000688 3200            	   225:     move.w  d0,d1
00:0000068A 0241000E        	   226:     andi.w  #$000E,d1
00:0000068E EF49            	   227:     lsl.w   #7,d1
00:00000690 8441            	   228:     or      d1,d2
                            	   229:     ; green: bits 7-5
00:00000692 3200            	   230:     move.w  d0,d1
00:00000694 024100E0        	   231:     andi.w  #$00E0,d1
00:00000698 E149            	   232:     lsl.w   #8,d1
00:0000069A 8441            	   233:     or      d1,d2
00:0000069C 3200            	   234:     move.w  d0,d1
00:0000069E 02410E00        	   235:     andi.w  #$0E00,d1
00:000006A2 EC49            	   236:     lsr.w   #6,d1
00:000006A4 8441            	   237:     or      d1,d2
00:000006A6 32C2            	   238:     move.w  d2,(a1)+
00:000006A8 51CBFFDA        	   239:     dbf     d3,.convert_loop
00:000006AC 4E75            	   240:     rts
                            	   241: 
                            	   242: 
                            	   243: ; =============================================================================
                            	   244: ; update_sega_logo_colours_x68k
                            	   245: ; Direct port of update_sega_logo_colours (alisia_dis.asm ~L784-798).
                            	   246: ; Steps backward through sega_logo_colours_x68k one word position every
                            	   247: ; 4th call, writing 11 converted colours into GPAL entries 2-12, until the
                            	   248: ; index goes negative (matches MD's "bmi .exit" -- this is a one-way run
                            	   249: ; through the table, NOT a repeating cycle; MD's original counted DOWN from
                            	   250: ; word index 20 to 0, i.e. 21 activations total, ~84 frames at 4 frames each).
                            	   251: ; =============================================================================
                            	   252: update_sega_logo_colours_x68k:
00:000006AE 48E7E0C0        	   253:     movem.l d0-d2/a0-a1,-(sp)
00:000006B2 5345            	   254:     subq.w  #1,d5
00:000006B4 6A20            	   255:     bpl.b   .exit
00:000006B6 3A3C0003        	   256:     move.w  #3,d5                    ; reload delay counter
00:000006BA 3006            	   257:     move.w  d6,d0
00:000006BC 6B18            	   258:     bmi.b   .exit                    ; table exhausted -- stop permanently
00:000006BE 5546            	   259:     subq.w  #2,d6                    ; move to previous table entry
00:000006C0 41F90000BF12    	   260:     lea     (sega_logo_colours_x68k),a0
00:000006C6 D0C0            	   261:     adda.w  d0,a0
00:000006C8 43F900E82004    	   262:     lea     (GPAL_BASE+4),a1         ; GPAL entry 2 (colour index 2)
00:000006CE 720A            	   263:     moveq   #(11-1),d1                   ; 11 colours
                            	   264: .copy_loop:
00:000006D0 32D8            	   265:     move.w  (a0)+,(a1)+
00:000006D2 51C9FFFC        	   266:     dbf     d1,.copy_loop
                            	   267: .exit:
00:000006D6 4CDF0307        	   268:     movem.l (sp)+,d0-d2/a0-a1
00:000006DA 4E75            	   269:     rts
                            	   270: 
                            	   271: 
                            	   272: ; increment_palette_if_palette_target_gt_d7 (00011176)
                            	   273: ; d7=colour level, a2=palette addr, a3=palette target addr
                            	   274: increment_palette_if_palette_target_gt_d7:
00:000006DC 2F07            	   275:     move.l      d7,-(SP)
00:000006DE 5247            	   276:     addq.w      #$1,d7
00:000006E0 E34F            	   277:     lsl.w       #$1,d7
00:000006E2 7C0F            	   278:     moveq       #$f,d6
                            	   279:     .loops_16_times:
00:000006E4 1012            	   280:         move.b      (a2),d0
00:000006E6 BE1B            	   281:         cmp.b       (a3)+,d7
00:000006E8 6208            	   282:         bhi.b       .L0
00:000006EA 0C00000E        	   283:         cmpi.b      #$0e,d0
00:000006EE 6402            	   284:         bcc.b       .L0
00:000006F0 5440            	   285:         addq.w      #$2,d0
                            	   286:     .L0:
00:000006F2 14C0            	   287:         move.b      d0,(a2)+
00:000006F4 121B            	   288:         move.b      (a3)+,d1
00:000006F6 1401            	   289:         move.b      d1,d2
00:000006F8 020100E0        	   290:         andi.b      #$e0,d1
00:000006FC E809            	   291:         lsr.b       #$4,d1
00:000006FE 1012            	   292:         move.b      (a2),d0
00:00000700 020000E0        	   293:         andi.b      #$e0,d0
00:00000704 BE01            	   294:         cmp.b       d1,d7
00:00000706 620A            	   295:         bhi.b       .L1
00:00000708 0C0000E0        	   296:         cmpi.b      #$e0,d0
00:0000070C 6404            	   297:         bcc.b       .L1
00:0000070E 06000020        	   298:         addi.b      #$20,d0
                            	   299:     .L1:
00:00000712 1200            	   300:         move.b      d0,d1
00:00000714 0202000E        	   301:         andi.b      #$0e,d2
00:00000718 1012            	   302:         move.b      (a2),d0
00:0000071A 0200000E        	   303:         andi.b      #$0e,d0
00:0000071E BE02            	   304:         cmp.b       d2,d7
00:00000720 6208            	   305:         bhi.b       .L2
00:00000722 0C00000E        	   306:         cmpi.b      #$0e,d0
00:00000726 6402            	   307:         bcc.b       .L2
00:00000728 5400            	   308:         addq.b      #$2,d0
                            	   309:     .L2:
00:0000072A 8200            	   310:         or.b        d0,d1
00:0000072C 14C1            	   311:         move.b      d1,(a2)+
00:0000072E 51CEFFB4        	   312:         dbf         d6,.loops_16_times
00:00000732 2E1F            	   313:     move.l      (SP)+,d7
00:00000734 4E75            	   314:     rts
                            	   315: 
                            	   316: ; decrement_palette
                            	   317: ; a2=palette addr, clobbers d0,d1,d6
                            	   318: decrement_palette:      ; (0001122e) + 1 to each colour up to 7
00:00000736 2F0A            	   319:     move.l      a2,-(SP)    ; save current A2 value
                            	   320:     DEC_N_COLOURS a2,d6,16
                            	     1M     INLINE
00:00000738 7C0F            	     2M     moveq       #(16-1),d6      ; will loop 16 times (32 bytes modified in total)
                            	     3M     .loop_n_times:
00:0000073A 1012            	     4M         move.b      (a2),d0
00:0000073C 6702            	     5M         beq.b       .save_b
00:0000073E 5500            	     6M         subq.b      #$2,d0      ; d0=d0-2
                            	     7M     .save_b:
00:00000740 14C0            	     8M         move.b      d0,(a2)+    ; save it back
00:00000742 1012            	     9M         move.b      (a2),d0
00:00000744 1200            	    10M         move.b      d0,d1
00:00000746 0201000E        	    11M         andi.b      #$0e,d1      ; d1=d0&$0e
00:0000074A 020000E0        	    12M         andi.b      #$e0,d0     ; d0=d0&$e0
00:0000074E 6704            	    13M         beq.b       .save_g
00:00000750 04000020        	    14M         subi.b      #$20,d0     ; d0=d0-$20
                            	    15M     .save_g:
00:00000754 4A01            	    16M         tst.b       d1
00:00000756 6702            	    17M         beq.b       .save_r
00:00000758 5541            	    18M         subq.w      #$2,d1      ; d1=d1-2
