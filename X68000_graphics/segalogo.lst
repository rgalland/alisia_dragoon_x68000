                            	   118:     ; --- Set up initial colour-cycle state and enable display ---
                            	   119:     ; MD: move.w #$0000,(palettes_4) / move.w #CRAM_WHITE,(palettes_4+2)
                            	   120:     ; then moveq #$0,d5 / moveq #$28,d6 / moveq #$0,d7 before enabling
                            	   121:     ; display and entering the wait loop. We don't need the palettes_4
                            	   122:     ; staging area at all (see deferred fade-in note above) — go straight
                            	   123:     ; to the live colour-cycle state.
00:000000DC 7A00            	   124:     moveq   #0,d5                  ; vblank delay counter (reload $3)
