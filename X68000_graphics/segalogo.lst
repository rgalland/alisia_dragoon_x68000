Source: "sega_logo_x68k.s"
                            	     1: ; =============================================================================
                            	     2: ; sega_logo_x68k.s — X68000 port of display_sega_logo
                            	     3: ; Ported from ad_md_sound_driver.s-adjacent graphics source (alisia_dis.asm),
                            	     4: ; "==== SEGA LOGO Assets and routines ====" section, lines ~700-814.
                            	     5: ;
                            	     6: ; Architecture decision (confirmed with Regis): bitmap blit onto the
                            	     7: ; 256-colour graphic layer 0 (GVRAM_PAGE0), NOT the PCG/BG tile-and-nametable
                            	     8: ; hardware. Tiles are copied once as pixel data at load time; there is no
                            	     9: ; runtime tilemap indirection or hardware scroll on the X68000 side for this
                            	    10: ; screen, since the Sega logo never scrolls.
                            	    11: ;
                            	    12: ; Display timing: CRTC_320_* preset (x68k_hw.i) — a 320x224 15kHz window
                            	    13: ; cropped from a confirmed-working 384x240 15kHz timing, left/top-anchored,
                            	    14: ; chosen specifically so MD tile/tilemap pixel coordinates (computed against
                            	    15: ; a 512-wide plane) carry over with zero rescaling. See x68k_hw.i comments
                            	    16: ; for the full derivation.
                            	    17: ;
                            	    18: ; NOT yet ported (explicitly deferred, see notes at end of file):
                            	    19: ;   - Joypad Start-skip logic (Regis is redesigning the joypad/keyboard
                            	    20: ;     layer separately)
                            	    21: ;   - The one-shot "fade in from black" nudge that prepare_dma_palette_transfer
                            	    22: ;     / modify_current_colours performs on palette 0 colours 1,13,14,15
                            	    23: ;     before the colour-cycle starts. Traced against the MD source: this
                            	    24: ;     produces at most a single +-2-per-channel nudge (not a multi-frame
                            	    25: ;     fade — see conversation notes) and only affects 4 of palette 0's 16
                            	    26: ;     colours, all of which are outside the 11 colours the visible
                            	    27: ;     colour-cycle touches. Low visual impact; can be added later if a
                            	    28: ;     side-by-side comparison shows it's noticeable.
                            	    29: ;
                            	    30: ; Assumes: sega_logo_tiles_8bpp (converted from sega_logo_tileset.bin, 4bpp
                            	    31: ; MD tile format -> 8bpp X68000 pixel format, palette indices 0-15,
                            	    32: ; preserving original tile numbering/order 1:1 including the unused tile 0)
                            	    33: ; has already been produced by a separate offline conversion step, not yet
                            	    34: ; written. Tile format: 49 tiles x 64 bytes (8x8 pixels, 1 byte/pixel),
                            	    35: ; tile 0 unused/skipped (matches MD source: sega_logo_tilemap references
                            	    36: ; tile indices 1-48 only, tile 0's slot is uploaded but never referenced).
                            	    37: ; =============================================================================
                            	    38: 
                            	    39:     include "x68k_hw.i"

Source: "x68k_hw.i"
                            	     1: ; =============================================================================
                            	     2: ; x68k_hw.i — X68000 Hardware Register Definitions
                            	     3: ; For use with VASM (Motorola 68k syntax)
                            	     4: ;
                            	     5: ; Verified against:
                            	     6: ;   - NFG Games / GameSX wiki (vidcon_registers)
                            	     7: ;   - MAME x68k video driver source
                            	     8: ;   - Retrobug.org hardware reference
                            	     9: ;
                            	    10: ; Memory map overview:
                            	    11: ;   $000000-$BxxxFF   Main RAM (1MB standard, up to 12MB expanded)
                            	    12: ;   $E00000-$E7FFFF   Graphic VRAM (4 pages x 512x512)
                            	    13: ;   $E80000-$E8001F   CRTC (screen timing and scroll, R00-R23 -- corrected,
                            	    14: ;                     was mislabelled elsewhere in this file as $C00000)
                            	    15: ;   $E82000-$E821FF   Graphic palette (256 words in 256-colour mode)
                            	    16: ;   $E82200-$E823FF   Text palette + Sprite/BG palette (16 blocks x 16 colours)
                            	    17: ;   $E82400           Video controller R0 (colour/size mode)
                            	    18: ;   $E82500           Video controller R1 (layer priority)
                            	    19: ;   $E82600           Video controller R2 (layer ON/OFF)
                            	    20: ;   $EB0000-$EB07FF   Sprite attribute table (128 entries)
                            	    21: ;   $EB0800-$EB0808   BG scroll + control registers
                            	    22: ;   $EB8000-$EBFFFF   PCG pattern RAM (32KB shared sprites+BG)
                            	    23: ;   $E88000-$E88FFF   MFP MC68901 (timers, interrupts)
                            	    24: ;   $E9A000-$E9A003   Joypad ports
                            	    25: ; =============================================================================
                            	    26: 
                            	    27: 
                            	    28: ; =============================================================================
                            	    29: ; CRTC — CRT Controller ($E80000)
                            	    30: ; Controls screen timing, resolution and scroll positions
                            	    31: ; All registers 16-bit write
                            	    32: ; =============================================================================
                            	    33: 
                            	    34: ; CORRECTED: was $C00000 in a previous revision of this file, which is
                            	    35: ; wrong. Confirmed against NFG Games/GameSX CRTC register wiki, the Data
                            	    36: ; Crystal X68k I/O map, and ChibiAkumas' X68000 assembly reference
                            	    37: ; (independently cross-checked, all agree): the CRTC is at $E80000, with
                            	    38: ; R00-R23 at 2-byte offsets from there. This also lines up with GPAL_BASE
                            	    39: ; ($E82000), TPAL_BASE ($E82200), VC_R0 ($E82400), VC_R2 ($E82600) further
                            	    40: ; down this file, which are all correctly $E80000-relative -- only the
                            	    41: ; CRTC_BASE/CRTC_R00-R20 block itself had the wrong base address.
                            	    42: CRTC_BASE           equ $E80000
                            	    43: 
                            	    44: CRTC_R00            equ $E80000     ; Horizontal total
                            	    45: CRTC_R01            equ $E80002     ; Horizontal sync end
                            	    46: CRTC_R02            equ $E80004     ; Horizontal display start
                            	    47: CRTC_R03            equ $E80006     ; Horizontal display end
                            	    48: CRTC_R04            equ $E80008     ; Vertical total
                            	    49: CRTC_R05            equ $E8000A     ; Vertical sync end
                            	    50: CRTC_R06            equ $E8000C     ; Vertical display start
                            	    51: CRTC_R07            equ $E8000E     ; Vertical display end
                            	    52: CRTC_R08            equ $E80010     ; Fine adjust
                            	    53: CRTC_R09            equ $E80012     ; Raster line (read: current raster position)
                            	    54: CRTC_R10            equ $E80014     ; Text layer horizontal scroll
                            	    55: CRTC_R11            equ $E80016     ; Text layer vertical scroll
                            	    56: CRTC_R12            equ $E80018     ; Graphic layer 0 horizontal scroll
                            	    57: CRTC_R13            equ $E8001A     ; Graphic layer 0 vertical scroll
                            	    58: CRTC_R14            equ $E8001C     ; Graphic layer 1 horizontal scroll (unused)
                            	    59: CRTC_R15            equ $E8001E     ; Graphic layer 1 vertical scroll  (unused)
                            	    60: CRTC_R16            equ $E80020     ; Graphic layer 2 horizontal scroll
                            	    61: CRTC_R17            equ $E80022     ; Graphic layer 2 vertical scroll
                            	    62: CRTC_R18            equ $E80024     ; Graphic layer 3 horizontal scroll (unused)
                            	    63: CRTC_R19            equ $E80026     ; Graphic layer 3 vertical scroll  (unused)
                            	    64: CRTC_R20            equ $E80028     ; Screen mode flags
                            	    65: CRTC_R21            equ $E8002A     ; ?
                            	    66: 
                            	    67: ; CRTC R20 bit fields:
                            	    68: ;   bit 12    : 1=1024 dot mode
                            	    69: ;   bit 11-10 : vertical res (00=256, 01=512, 1x=1024 interlace)
                            	    70: ;   bit 9-8   : horizontal res (00=256, 01=512, 10=768)
                            	    71: ;   bit 1     : 1=interlace
                            	    72: ;   bit 0     : 1=31kHz, 0=15kHz
                            	    73: ; NOTE: bits 9-8 must match VC R0 colour mode bits
                            	    74: 
                            	    75: ; Convenient aliases for scroll registers
                            	    76: ; In 256-colour 2-layer mode:
                            	    77: ;   Pages 0+1 = Layer 0 (background)  → CRTC R12/R13
                            	    78: ;   Pages 2+3 = Layer 1 (foreground)  → CRTC R16/R17
                            	    79: GFX_L0_HSCROLL      equ CRTC_R12
                            	    80: GFX_L0_VSCROLL      equ CRTC_R13
                            	    81: GFX_L1_HSCROLL      equ CRTC_R16
                            	    82: GFX_L1_VSCROLL      equ CRTC_R17
                            	    83: 
                            	    84: ; --- CRTC preset values for 256x256 15kHz ---
                            	    85: CRTC_256_R00        equ $003F
                            	    86: CRTC_256_R01        equ $0009
                            	    87: CRTC_256_R02        equ $000E
                            	    88: CRTC_256_R03        equ $002E
                            	    89: CRTC_256_R04        equ $010B
                            	    90: CRTC_256_R05        equ $0005
                            	    91: CRTC_256_R06        equ $0028
                            	    92: CRTC_256_R07        equ $0128
                            	    93: CRTC_256_R08        equ $001B
                            	    94: CRTC_256_R20        equ $0000       ; 256x256 15kHz, must match VC_R0_256COL
                            	    95: 
                            	    96: ; --- CRTC preset values for 320x224 15kHz (MD H40-equivalent) ---
                            	    97: ; Derived from a confirmed/tested "384x240 15kHz" register set (mid/512-dot
                            	    98: ; family — required pairing for 256-colour graphic mode, see VC_R0 note
                            	    99: ; below) sourced from a period X68000 CRTC hardware reference. Rather than
                            	   100: ; deriving H/V timing from scratch, this crops the confirmed-working 384x240
                            	   101: ; timing down to 320x224 by reducing only the display-END registers (R03,
                            	   102: ; R07), leaving H-total/V-total and all other timing untouched:
                            	   103: ;   R03 (H disp end): $003A -> $0032  (-8 units = -64 dots: 384 -> 320 wide)
                            	   104: ;   R07 (V disp end):  $0100 -> $00F0  (-16 lines: 240 -> 224 tall)
                            	   105: ; Cropping from the END register (not the START) keeps the visible window
                            	   106: ; left/top-anchored at the same origin as the uncropped 384x240 mode, so
                            	   107: ; MD tile/tilemap pixel coordinates (computed against a 512-wide plane,
                            	   108: ; itself left-anchored at column 0) carry over with zero rescaling — see
                            	   109: ; the Sega logo port notes.
                            	   110: ; Source 384x240 15kHz register set (untouched fields) for reference:
                            	   111: ;   R00-R08: $0042,$0005,$000A,$003A,$0103,$0002,$0010,$0100,$002C
                            	   112: CRTC_320_R00         equ $004c   ;$0042
                            	   113: CRTC_320_R01         equ $0010   ;$0005
                            	   114: CRTC_320_R02         equ $001A   ;$000A
                            	   115: CRTC_320_R03         equ $0045   ;$0032      ; cropped from $003A (384 -> 320 wide)
                            	   116: CRTC_320_R04         equ $0103
                            	   117: CRTC_320_R05         equ $0002
                            	   118: CRTC_320_R06         equ $0018   ;$0010
                            	   119: CRTC_320_R07         equ $00f8   ;$00F0      ; cropped from $0100 (240 -> 224 tall)
                            	   120: CRTC_320_R08         equ $0024   ;$002C
                            	   121: CRTC_320_R20         equ $0001   ;$0100      ; bits9-8=01 (512/mid family, required
                            	   122: CRTC_320_R21         equ $0033
                            	   123:               
                            	   124:                                              
                            	   125: 
                            	   126: 
                            	   127: ; =============================================================================
                            	   128: ; Text VRAM — $C00000 (512KB total, 4 x 128KB pages)
                            	   129: ;
                            	   130: ; In 256-colour mode (our target):
                            	   131: ;   2 page pairs active, each pair = one independently scrolling layer
                            	   132: ;   Each pixel = 1 word (4/8-bit index based on resolution)
                            	   133: ;   Virtual space per layer = 512x512 pixels
                            	   134: ;
                            	   135: ;   Layer 0 (background scroll) : pages 0+1  $C00000
                            	   136: ;   Layer 1 (foreground scroll) : pages 2+3  $C80000
                            	   137: ;
                            	   138: ; Writing pixels in 256-colour mode:
                            	   139: ;   A pixel at position (x,y) on layer 0:
                            	   140: ;     address = GVRAM_PAGE0 + (y * GVRAM_WIDTH) + x
                            	   141: ;   A pixel at position (x,y) on layer 1:
                            	   142: ;     address = GVRAM_PAGE2 + (y * GVRAM_WIDTH) + x
                            	   143: ;
                            	   144: ; Clearing a layer: fill with colour index 0 (transparent/background)
                            	   145: ; Tile blitting: copy 8 or 16 pixel rows of colour index bytes
                            	   146: ; =============================================================================
                            	   147: 
                            	   148: GVRAM_BASE          equ $C00000
                            	   149: GVRAM_PAGE0         equ $C00000     
                            	   150: GVRAM_PAGE1         equ $C80000     
                            	   151: GVRAM_PAGE2         equ $D00000     ; Only used in 4bpp mode
                            	   152: GVRAM_PAGE3         equ $D80000     ; Only used in 4bpp mode
                            	   153: GVRAM_PAGE_SIZE     equ $080000     ; 128KB per page
                            	   154: GVRAM_WIDTH         equ $200*2      ; virtual layer width in bytes (1 word per pixel) 
                            	   155: GVRAM_HEIGHT        equ $200        ; virtual layer height in pixels
                            	   156: 
                            	   157: ; =============================================================================
                            	   158: ; Textc VRAM — $E00000 (512KB total, 4 x 128KB pages)
                            	   159: ;
                            	   160: ; 4bpp planar mode:
                            	   161: ; bit0 : $E00000
                            	   162: ; bit1 : $E20000
                            	   163: ; bit2 : $E40000
                            	   164: ; bit3 : $E60000
                            	   165: ; Each pixel = 1 bit from each plane
                            	   166: ;   Virtual space per layer = 512x512 pixels
                            	   167: ;
                            	   168: ;   Layer 0 (background scroll) : pages 0+1  $E00000 / $E20000
                            	   169: ;   Layer 1 (foreground scroll) : pages 2+3  $E40000 / $E60000
                            	   170: ;
                            	   171: ; Writing pixels in 256-colour mode:
                            	   172: ;   A pixel at position (x,y) on layer 0:
                            	   173: ;     address = TVRAM_PAGE0 + (y * TVRAM_WIDTH) + x
                            	   174: ;   A pixel at position (x,y) on layer 1:
                            	   175: ;     address = TVRAM_PAGE2 + (y * TVRAM_WIDTH) + x
                            	   176: ;
                            	   177: ; Clearing a layer: fill with colour index 0 (transparent/background)
                            	   178: ; Tile blitting: copy 8 or 16 pixel rows of colour index bytes
                            	   179: 
                            	   180: TVRAM_BASE          equ $E00000
                            	   181: TVRAM_PAGE0         equ $E00000     ; Layer 0
                            	   182: TVRAM_PAGE1         equ $E20000     ; Layer 0 (256-colour pair, may be unused directly)
                            	   183: TVRAM_PAGE2         equ $E40000     ; Layer 1
                            	   184: TVRAM_PAGE3         equ $E60000     ; Layer 1 (256-colour pair, may be unused directly)
                            	   185: TVRAM_PAGE_SIZE     equ $20000      ; 128KB per page
                            	   186: TVRAM_WIDTH         equ 512         ; virtual layer width in pixels
                            	   187: TVRAM_HEIGHT        equ 512         ; virtual layer height in pixels
                            	   188: 
                            	   189: 
                            	   190: 
                            	   191: ; =============================================================================
                            	   192: ; Graphic Palette — $E82000
                            	   193: ;
                            	   194: ; Used ONLY by graphic VRAM layers. Independent from sprite/text palettes.
                            	   195: ;
                            	   196: ; In 256-colour mode: 256 entries x 2 bytes = 512 bytes ($E82000-$E821FF)
                            	   197: ; Each entry is a 16-bit colour word directly output to display.
                            	   198: ;
                            	   199: ; Colour format (16-bit word):
                            	   200: ;   bit  15    : unused (always 0)
                            	   201: ;   bits 14-10 : Red   (5 bits, 0=dark, 31=full)
                            	   202: ;   bits  9-5  : Green (5 bits)
                            	   203: ;   bits  4-0  : Blue  (5 bits)
                            	   204: ;   Format: 0RRRRR GGGGG BBBBB
                            	   205: ;
                            	   206: ; Index 0 = layer background colour (shown where no other layer is visible)
                            	   207: ;
                            	   208: ; MD-to-X68k colour conversion:
                            	   209: ;   MD  3-bit channel (0-7):  stored as (value << 1) in bits 3-1
                            	   210: ;   X68k 5-bit channel (0-31): scale with x68k = md_3bit * 4 + md_3bit / 2
                            	   211: ;   Simpler: x68k = (md_raw_nibble >> 1) * 36 / 32  (use lookup table)
                            	   212: ;
                            	   213: ; Address of entry N: GPAL_BASE + (N * 2)
                            	   214: ; =============================================================================
                            	   215: 
                            	   216: GPAL_BASE           equ $E82000
                            	   217: GPAL_ENTRY_SIZE     equ 2           ; bytes per palette entry
                            	   218: GPAL_COUNT          equ 256         ; entries in 256-colour mode
                            	   219: 
                            	   220: SPAL_BASE           equ $E82200
                            	   221: SPAL_ENTRY_SIZE     equ 2           ; bytes per palette entry
                            	   222: SPAL_COUNT          equ 256         ; entries in 256-colour mode
                            	   223: 
                            	   224: COL_RED_SHIFT       equ 10
                            	   225: COL_GREEN_SHIFT     equ 5
                            	   226: COL_BLUE_SHIFT      equ 0
                            	   227: COL_RED_MASK        equ $7C00
                            	   228: COL_GREEN_MASK      equ $03E0
                            	   229: COL_BLUE_MASK       equ $001F
                            	   230: 
                            	   231: COL_BLACK           equ $0000
                            	   232: COL_WHITE           equ $7FFF
                            	   233: COL_RED             equ $7C00
                            	   234: COL_GREEN           equ $03E0
                            	   235: COL_BLUE            equ $001F
                            	   236: 
                            	   237: 
                            	   238: ; =============================================================================
                            	   239: ; Text + Sprite/BG Palette — $E82200
                            	   240: ;
                            	   241: ; Completely separate from graphic palette.
                            	   242: ; Covers 16 blocks x 16 colours x 2 bytes = 512 bytes ($E82200-$E823FF)
                            	   243: ;
                            	   244: ; Text layer uses block 0 only ($E82200-$E8221F)
                            	   245: ; Sprite system uses all 16 blocks via 4-bit palette select in sprite attr
                            	   246: ;
                            	   247: ; Colour index for sprites:
                            	   248: ;   upper 4 bits = palette block (from sprite attribute bits 3-0)
                            	   249: ;   lower 4 bits = pixel value (from PCG pattern data nibble)
                            	   250: ;   combined 8-bit value indexes into this 256-entry palette area
                            	   251: ;
                            	   252: ; Address of block B, colour C:
                            	   253: ;   TPAL_BASE + (B * TPAL_BLOCK_SIZE) + (C * 2)
                            	   254: ; =============================================================================
                            	   255: 
                            	   256: TPAL_BASE           equ $E82200
                            	   257: TPAL_BLOCK_SIZE     equ $20         ; 32 bytes = 16 colours per block
                            	   258: TPAL_BLOCK_COUNT    equ 16
                            	   259: TEXT_PAL_BASE       equ $E82200     ; text layer palette = block 0
                            	   260: 
                            	   261: 
                            	   262: ; =============================================================================
                            	   263: ; Video Controller Registers
                            	   264: ; =============================================================================
                            	   265: 
                            	   266: ; VC R0 — Colour/size mode ($E82400)
                            	   267: ;   bit  2   : GVRAM size 0=512x512  1=1024x1024
                            	   268: ;   bits 1-0 : colour mode 00=16col  01=256col  11=65536col
                            	   269: ;   MUST match CRTC R20 bits 9-8
                            	   270: VC_R0               equ $E82400
                            	   271: VC_R0_512           equ $0000       ; 512x512 GVRAM size
                            	   272: VC_R0_1024          equ $0004       ; 1024x1024 GVRAM size
                            	   273: VC_R0_16COL         equ $0000       ; 16 colour graphic
                            	   274: VC_R0_256COL        equ $0001       ; 256 colour graphic (our target)
                            	   275: VC_R0_65536COL      equ $0003       ; 65536 colour graphic
                            	   276: 
                            	   277: ; Our target VC R0 value: 512x512 + 256 colour
                            	   278: VC_R0_GAME          equ VC_R0_512|VC_R0_256COL
                            	   279: 
                            	   280: ; VC R1 — Layer priority ($E82500)
                            	   281: ;   bits 13-12 : SP  sprite priority  (00=highest 01=second 10=third)
                            	   282: ;   bits 11-10 : TX  text priority
                            	   283: ;   bits  9-8  : GR  graphic priority
                            	   284: ;   bits  7-0  : GP3-GP0 graphic page order
                            	   285: ;   For 256-colour 2-page: GP=$E4 means page1 < page0
                            	   286: VC_R1               equ $E82500
                            	   287: 
                            	   288: ; Sprite on top, text (HUD) second, graphic layers below
                            	   289: ; SP=00, TX=01, GR=10, GP=$E4
                            	   290: VC_R1_GAME          equ (($2<<8)|$E4)
                            	   291: 
                            	   292: ; VC R2 — Layer ON/OFF ($E82600)
                            	   293: ;   bit  6 : SON sprite screen ON
                            	   294: ;   bit  5 : TON text screen ON
                            	   295: ;   bit  3 : GS3 graphic page 3 ON  (layer 1 high)
                            	   296: ;   bit  2 : GS2 graphic page 2 ON  (layer 1 low)
                            	   297: ;   bit  1 : GS1 graphic page 1 ON  (layer 0 high)
                            	   298: ;   bit  0 : GS0 graphic page 0 ON  (layer 0 low)
                            	   299: ;   In 256-colour mode set both pages of each pair together
                            	   300: VC_R2               equ $E82600
                            	   301: VC_SPRITE_ON        equ $0040
                            	   302: VC_TEXT_ON          equ $0020
                            	   303: VC_GFX_1024_ON      equ $0010       ; 1024 on
                            	   304: VC_GFX_L0_ON        equ $0003       ; pages 0+1 = layer 0
                            	   305: VC_GFX_L1_ON        equ $000C       ; pages 2+3 = layer 1
                            	   306: 
                            	   307: ; Combined value: sprites + text HUD + both graphic layers
                            	   308: ;VC_R2_GAME          equ VC_SPRITE_ON|VC_TEXT_ON|VC_GFX_L0_ON|VC_GFX_L1_ON
                            	   309: VC_R2_GAME          equ VC_SPRITE_ON|VC_GFX_1024_ON|VC_GFX_L0_ON|VC_GFX_L1_ON
                            	   310: 
                            	   311: ; =============================================================================
                            	   312: ; Sprite attribute table — $EB0000
                            	   313: ; 128 entries x 8 bytes
                            	   314: ;
                            	   315: ; Entry layout (4 words):
                            	   316: ; ------XXXXXXXXXX : x position on 10 bits
                            	   317: ; ------YYYYYYYYYY : y position on 10 bits
                            	   318: ; VH--CCCCSSSSSSSS : V and H flip, palette on 4 bits and tile addr in memory
                            	   319: ; --------------PP : Priority - "00"=off, "01"=back, "11"=front
                            	   320: ;
                            	   321: ; PCG colour index = (palette_block << 4) | pcg_pixel_nibble
                            	   322: ; indexes into sprite/BG palette at $E82200
                            	   323: ; =============================================================================
                            	   324: 
                            	   325: SPRITE_TABLE        equ $EB0000
                            	   326: SPRITE_ENTRY_SIZE   equ 8
                            	   327: SPRITE_MAX          equ 128
                            	   328: 
                            	   329: SP_OFF_X            equ 0
                            	   330: SP_OFF_Y            equ 2
                            	   331: SP_OFF_ATTR_ADDR    equ 4
                            	   332: SP_OFF_PRI          equ 6
                            	   333: 
                            	   334: SP_X_OFFSET         equ 16
                            	   335: SP_Y_OFFSET         equ 16
                            	   336: 
                            	   337: SP_PATTERN_SHIFT    equ 8
                            	   338: SP_PATTERN_MASK     equ $FF00
                            	   339: SP_VFLIP            equ $0080
                            	   340: SP_HFLIP            equ $0040
                            	   341: SP_PAL_MASK         equ $000F
                            	   342: 
                            	   343: SP_LINK_MASK        equ $007F
                            	   344: 
                            	   345: 
                            	   346: ; =============================================================================
                            	   347: ; PCG Pattern RAM — $EB8000 (32KB)
                            	   348: ;
                            	   349: ; Shared between sprites, BG0 and BG1 (BG unused in our config)
                            	   350: ; 256 patterns maximum, each pattern = 16x16 pixels 4bpp = 128 bytes
                            	   351: ;
                            	   352: ; Pattern data format:
                            	   353: ;   128 bytes = 16 rows x 8 bytes
                            	   354: ;   Each byte = 2 pixels: high nibble = left pixel, low nibble = right pixel
                            	   355: ;   Pixel nibble = lower 4 bits of colour index
                            	   356: ;   Upper 4 bits of colour index come from sprite attribute palette field
                            	   357: ;
                            	   358: ; Address of pattern N: PCG_BASE + (N * PCG_PATTERN_BYTES)
                            	   359: ; =============================================================================
                            	   360: 
                            	   361: PCG_BASE            equ $EB8000
                            	   362: PCG_PATTERN_BYTES   equ 128
                            	   363: PCG_MAX_PATTERNS    equ 256
                            	   364: 
                            	   365: 
                            	   366: ; =============================================================================
                            	   367: ; BG control (defined for completeness, BG layers unused in our config)
                            	   368: ; =============================================================================
                            	   369: 
                            	   370: BG0_HSCROLL         equ $EB0800  ;$0
                            	   371: BG0_VSCROLL         equ $EB0802  ;$0
                            	   372: BG1_HSCROLL         equ $EB0804  ;$0
                            	   373: BG1_VSCROLL         equ $EB0806  ;$0
                            	   374: BG_CTRL             equ $EB0808  ;$212
                            	   375: BG_H_TOTAL          equ $EB080A  ;$ff
                            	   376: BG_H_POS            equ $EB080C  ;$f
                            	   377: BG_V_POS            equ $EB080E  ;$31
                            	   378: BG_RES              equ $EB0810  ;$0
                            	   379: 
                            	   380: BG_SPRITE_HEAD_SHIFT equ 9
                            	   381: 
                            	   382: 
                            	   383: ; =============================================================================
                            	   384: ; MFP MC68901 — $E88000
                            	   385: ; =============================================================================
                            	   386: 
                            	   387: MFP_BASE            equ $E88000
                            	   388: MFP_GPDR            equ $E88001
                            	   389: MFP_DDR             equ $E88003
                            	   390: MFP_IERA            equ $E88007
                            	   391: MFP_IERB            equ $E88009
                            	   392: MFP_IPRA            equ $E8800B
                            	   393: MFP_IPRB            equ $E8800D
                            	   394: MFP_ISRA            equ $E8800F
                            	   395: MFP_ISRB            equ $E88011
                            	   396: MFP_IMRA            equ $E88013
                            	   397: MFP_IMRB            equ $E88015
                            	   398: MFP_VR              equ $E88017
                            	   399: MFP_TACR            equ $E88019
                            	   400: MFP_TBCR            equ $E8801B
                            	   401: MFP_TCDCR           equ $E8801D
                            	   402: MFP_TADR            equ $E8801F
                            	   403: MFP_TBDR            equ $E88021
                            	   404: MFP_TCDR            equ $E88023
                            	   405: MFP_TDDR            equ $E88025
                            	   406: 
                            	   407: MFP_VECTOR_BASE     equ $40
                            	   408: FM_IRQ_VECTOR       equ $43    ; MFP FM Audio source — this is where YM2151 timer interrupts land
                            	   409: VBLANK_VECTOR       equ $46
                            	   410: TIMER_B_VECTOR      equ $48
                            	   411: TIMER_A_VECTOR      equ $4D
                            	   412: 
                            	   413: 
                            	   414: ; =============================================================================
                            	   415: ; Joypad
                            	   416: ; =============================================================================
                            	   417: 
                            	   418: JOY1_PORT           equ $E9A000
                            	   419: JOY2_PORT           equ $E9A002
                            	   420: 
                            	   421: JOY_RIGHT           equ $20
                            	   422: JOY_LEFT            equ $10
                            	   423: JOY_DOWN            equ $08
                            	   424: JOY_UP              equ $04
                            	   425: JOY_BTN_B           equ $02
                            	   426: JOY_BTN_A           equ $01
                            	   427: 
                            	   428: 
                            	   429: ; =============================================================================
                            	   430: ; Screen layout constants — adjust to match chosen CRTC mode
                            	   431: ; =============================================================================
                            	   432: 
                            	   433: ;SCREEN_WIDTH        equ 256
                            	   434: ;SCREEN_HEIGHT       equ 256
                            	   435: ;GVRAM_VWIDTH        equ 512         ; virtual scroll space width
                            	   436: ;GVRAM_VHEIGHT       equ 512         ; virtual scroll space height
                            	   437: 

Source: "sega_logo_x68k.s"
                            	    40:     include "x68k_macros.i"

Source: "x68k_macros.i"
                            	     1: ; =============================================================================
                            	     2: ; x68k_macros.i — X68000 Utility Macros
                            	     3: ; For use with VASM (Motorola 68k syntax)
                            	     4: ;
                            	     5: ; Include after x68k_hw.i:
                            	     6: ;    ifnd "x68k_hw.i"
                            	     7: ;    include "x68k_hw.i"
                            	     8: ;    endif
                            	     9: ;    ifnd "x68k_macros.i"
                            	    10: ;    include "x68k_macros.i"
                            	    11: ;    endif
                            	    12: 
                            	    13: ;include "x68k_macros.i"
                            	    14: ; =============================================================================
                            	    15: 
                            	    16: 
                            	    17: ; =============================================================================
                            	    18: ; CRTC macros
                            	    19: ; =============================================================================
                            	    20: 
                            	    21: ; CRTC_WRITE reg, value
                            	    22: ; Write an immediate value to a CRTC register
                            	    23: ; Clobbers: nothing (uses move.w immediate)
                            	    24: CRTC_WRITE  MACRO
                            	    25:     move.w  #\2,\1
                            	    26:     ENDM
                            	    27: 
                            	    28: ; SET_SCROLL_L0 hscroll_reg, vscroll_reg
                            	    29: ; Set horizontal and vertical scroll for graphic layer 0
                            	    30: ; \1 = data register holding H scroll value
                            	    31: ; \2 = data register holding V scroll value
                            	    32: SET_SCROLL_L0   MACRO
                            	    33:     move.w  \1,(GFX_L0_HSCROLL)
                            	    34:     move.w  \2,(GFX_L0_VSCROLL)
                            	    35:     ENDM
                            	    36: 
                            	    37: ; SET_SCROLL_L1 hscroll_reg, vscroll_reg
                            	    38: ; Set horizontal and vertical scroll for graphic layer 1
                            	    39: SET_SCROLL_L1   MACRO
                            	    40:     move.w  \1,(GFX_L1_HSCROLL)
                            	    41:     move.w  \2,(GFX_L1_VSCROLL)
                            	    42:     ENDM
                            	    43: 
                            	    44: 
                            	    45: ; =============================================================================
                            	    46: ; Palette macros
                            	    47: ; =============================================================================
                            	    48: 
                            	    49: ; SET_GPAL_ENTRY index, colour
                            	    50: ; Write a single colour word to graphic palette entry N
                            	    51: ; \1 = palette index (immediate or data register)
                            	    52: ; \2 = 16-bit colour word (immediate)
                            	    53: ; Clobbers: a0
                            	    54: SET_GPAL_ENTRY  MACRO
                            	    55:     lea     (GPAL_BASE),a0
                            	    56:     move.w  \2,((\1)*GPAL_ENTRY_SIZE,a0)
                            	    57:     ENDM
                            	    58: 
                            	    59: ; COPY_PALETTE src_addr, dst_palette_addr, count
                            	    60: ; Copy count colour words from src to palette RAM
                            	    61: ; \1 = source address register (a0-a6)
                            	    62: ; \2 = destination address register pointing into palette RAM
                            	    63: ; \3 = data register holding word count
                            	    64: ; Clobbers: \3 (used as dbf counter)
                            	    65: COPY_PALETTE    MACRO
                            	    66:     subq.w  #1,\3
                            	    67: .cp_loop\@:
                            	    68:     move.w  (\1)+,(\2)+
                            	    69:     dbf     \3,.cp_loop\@
                            	    70:     ENDM
                            	    71: 
                            	    72: ; CLEAR_GPAL
                            	    73: ; Zero all 256 graphic palette entries (black)
                            	    74: ; Clobbers: d0, a0
                            	    75: CLEAR_GPAL  MACRO
                            	    76:     lea     (GPAL_BASE),a0
                            	    77:     move.w  #(GPAL_COUNT-1),d0
                            	    78: .cgp_loop\@:
                            	    79:     clr.w   (a0)+
                            	    80:     dbf     d0,.cgp_loop\@
                            	    81:     ENDM
                            	    82: 
                            	    83: ; CLEAR_SPAL
                            	    84: ; Zero all 256 graphic palette entries (black)
                            	    85: ; Clobbers: d0, a0
                            	    86: CLEAR_SPAL  MACRO
                            	    87:     lea     (SPAL_BASE),a0
                            	    88:     move.w  #(SPAL_COUNT-1),d0
                            	    89: .csp_loop\@:
                            	    90:     clr.w   (a0)+
                            	    91:     dbf     d0,.csp_loop\@
                            	    92:     ENDM
                            	    93: 
                            	    94: 
                            	    95: ; CONVERT_MD_TO_X68K_COLOURS \1 = palette src, \2 = palette dst, \3 = d3 colour count
                            	    96: ; return a0 as updated dst palette
                            	    97: CONVERT_MD_TO_X68K_COLOURS MACRO
                            	    98:     movem.l d0-d3/a0-a1,-(sp)
                            	    99:     lea     (\1),a0
                            	   100:     lea     (\2),a1
                            	   101:     moveq   #\3,d3
                            	   102:     bsr     convert_md_colours_to_x68k
                            	   103:     movem.l (sp)+,d0-d3/a0-a1
                            	   104:     ENDM
                            	   105: 
                            	   106: 
                            	   107: ; =============================================================================
                            	   108: ; Graphic VRAM macros
                            	   109: ; =============================================================================
                            	   110: 
                            	   111: ; GVRAM_ADDR_L0 x_reg, y_reg, result_reg
                            	   112: ; Calculate byte address in graphic layer 0 VRAM for pixel (x,y)
                            	   113: ; \1 = data register holding X (pixel column, 0-511)
                            	   114: ; \2 = data register holding Y (pixel row,    0-511)
                            	   115: ; \3 = address register to receive result
                            	   116: ; Formula: GVRAM_PAGE0 + (Y * GVRAM_WIDTH) + X*2
                            	   117: ; Clobbers: d0, \3
                            	   118: GVRAM_ADDR_L0   MACRO
                            	   119:     move.w   \2,d0
                            	   120:     mulu.w   #GVRAM_WIDTH,d0
                            	   121:     lea      (GVRAM_PAGE0),\3
                            	   122:     adda.l   d0,\3
                            	   123:     adda.w   \1,\3     
                            	   124:     adda.w   \1,\3  ; add twice to point at words
                            	   125:     ENDM
                            	   126: 
                            	   127: ; GVRAM_ADDR_L1 x_reg, y_reg, result_reg
                            	   128: ; Calculate byte address in graphic layer 1 VRAM for pixel (x,y)
                            	   129: GVRAM_ADDR_L1   MACRO
                            	   130:     move.w   \2,d0
                            	   131:     mulu.w   #GVRAM_WIDTH,d0
                            	   132:     lea      (GVRAM_PAGE2),\3
                            	   133:     adda.l   d0,\3
                            	   134:     adda.w   \1,\3     
                            	   135:     adda.w   \1,\3  ; add twice to point at words
                            	   136:     ENDM
                            	   137: 
                            	   138: ; CLEAR_GVRAM_L0 colour_index
                            	   139: ; Fill entire graphic layer 0 VRAM with a colour index byte
                            	   140: ; \1 = immediate byte value (colour index)
                            	   141: ; Clobbers: d0, d1, a0
                            	   142: ; Note: clears full 512x512 = 262144 bytes
                            	   143: CLEAR_GVRAM_L0  MACRO
                            	   144:     lea     (GVRAM_PAGE0),a0
                            	   145:     move.l  #(GVRAM_PAGE_SIZE/2)-1,d0   ; divide by 2 as words will be processed
                            	   146:     moveq   #$0,d1    
                            	   147:     move.b  #\1,d1
                            	   148: .cgl0\@:
                            	   149:     move.w  d1,(a0)+
                            	   150:     dbf     d0,.cgl0\@
                            	   151:     ENDM
                            	   152: 
                            	   153: ; CLEAR_GVRAM_L1 colour_index
                            	   154: ; Fill entire graphic layer 1 VRAM with a colour index byte
                            	   155: CLEAR_GVRAM_L1  MACRO
                            	   156:     lea     (GVRAM_PAGE2),a0
                            	   157:     move.l  #(GVRAM_PAGE_SIZE/2)-1,d0
                            	   158:     moveq   #$0,d1    
                            	   159:     move.b  #\1,d1
                            	   160: .cgl1\@:
                            	   161:     move.w  d1,(a0)+
                            	   162:     dbf     d0,.cgl1\@
                            	   163:     ENDM
                            	   164: 
                            	   165: 
                            	   166: ; =============================================================================
                            	   167: ; Tileset copy macros
                            	   168: ;
                            	   169: ; In 256-colour mode, tile pixel data is 8bpp (1 byte per pixel).
                            	   170: ; MD tilesets are 4bpp (2 pixels per byte, packed nibbles).
                            	   171: ; After your startup conversion (4bpp -> 8bpp with palette offset applied),
                            	   172: ; tiles are stored in RAM as 8bpp ready for direct VRAM copy.
                            	   173: ;
                            	   174: ; Tile dimensions on X68000 graphic layers:
                            	   175: ;   We choose 8x8 tiles to match MD, but any size is valid since the
                            	   176: ;   graphic layer is a plain framebuffer — tiles are just rectangular blits.
                            	   177: ;
                            	   178: ; TILE_W / TILE_H defined here — change if your port uses different tile sizes
                            	   179: ; =============================================================================
                            	   180: 
                            	   181: TILE_W          equ 8               ; tile width in pixels
                            	   182: TILE_H          equ 8               ; tile height in pixels
                            	   183: TILE_WORDS      equ TILE_W*TILE_H   ; 1 word per pixel = 64 in 8bpp or 4bpp regardless
                            	   184: MD_TILE_BYTES   equ TILE_W*TILE_H/2 ; 2 pixels per byte
                            	   185: 
                            	   186: ; BLIT_TILE_L0 src_areg, x_dreg, y_dreg, tmp_areg
                            	   187: ; Copy one 8x8 8bpp tile from RAM to graphic layer 0 VRAM
                            	   188: ; \1 = address register pointing to tile source data (4bpp, 32 bytes)
                            	   189: ; \2 = data register holding tile X pixel position
                            	   190: ; \3 = data register holding tile Y pixel position
                            	   191: ; \4 = scratch address register for VRAM destination
                            	   192: ; Clobbers: \4, d0, d1, d4, d5
                            	   193: BLIT_TILE_L0    MACRO
                            	   194:     GVRAM_ADDR_L0 \2,\3,\4          ; calculate VRAM destination
                            	   195:     move.w  #(TILE_W-1),d1
                            	   196:     .bt_row\@:
                            	   197:         move.l  (\1)+,d4                ; copy 8 pixels
                            	   198:         move.w  #(TILE_H-1),d0          
                            	   199:         .bt_col\@:
                            	   200:             rol.l   #$4,d4                  ; shift for next nibble    
                            	   201:             move.w  d4,d5                   ; copy word as only bottom nibble is used
                            	   202:             and.w   #$000f,d5               ; TODO as a pallet nibble to bits 7-4
                            	   203:             move.w  d5,(\4)+
                            	   204:             dbf     d0,.bt_col\@
                            	   205:         lea     (GVRAM_WIDTH-TILE_W*2,\4),\4   ; advance destination by one row stride
                            	   206:         dbf     d1,.bt_row\@
                            	   207:     ENDM
                            	   208: 
                            	   209: ; BLIT_TILE_L1 src_areg, x_dreg, y_dreg, tmp_areg
                            	   210: ; Copy one 8x8 8bpp tile to graphic layer 1 VRAM
                            	   211: BLIT_TILE_L1    MACRO
                            	   212:     GVRAM_ADDR_L1 \2,\3,\4          ; calculate VRAM destination
                            	   213:     move.w  #(TILE_W-1),d1
                            	   214:     .bt_row\@:
                            	   215:         move.l  (\1)+,d4                ; copy 8 pixels
                            	   216:         move.w  #(TILE_H-1),d0
                            	   217:         .bt_col\@:
                            	   218:             rol.l   #$4,d4                  ; shift for next nibble
                            	   219:             move.w  d4,d5                   ; copy word as only bottom nibble is used
                            	   220:             and.w   #$000f,d5               ; TODO as a pallet nibble to bits 7-4
                            	   221:             move.w  d5,(\4)+
                            	   222:             dbf     d0,.bt_col\@
                            	   223:         lea     (GVRAM_WIDTH-TILE_W*2,\4),\4   ; advance destination by one row stride
                            	   224:         dbf     d1,.bt_row\@
                            	   225:     ENDM
                            	   226: 
                            	   227: 
                            	   228: ; =============================================================================
                            	   229: ; Sprite macros
                            	   230: ; =============================================================================
                            	   231: 
                            	   232: ; SPRITE_SET index, x, y, pattern, palette, hflip, vflip
                            	   233: ; Write all fields of a sprite table entry
                            	   234: ; \1 = sprite index (immediate, 0-127)
                            	   235: ; \2 = X screen coordinate (immediate or dreg)
                            	   236: ; \3 = Y screen coordinate (immediate or dreg)
                            	   237: ; \4 = pattern number (immediate, 0-255)
                            	   238: ; \5 = palette block (immediate, 0-15)
                            	   239: ; \6 = hflip (0 or SP_HFLIP)
                            	   240: ; \7 = vflip (0 or SP_VFLIP)
                            	   241: ; \8 = priority (0,1,2,3)
                            	   242: ; Clobbers: a0, d0
                            	   243: SPRITE_SET  MACRO
                            	   244:     lea     (SPRITE_TABLE+(\1*SPRITE_ENTRY_SIZE)),a0
                            	   245:     move.w  #(\2+SP_X_OFFSET),(SP_OFF_X,a0)
                            	   246:     move.w  #(\3+SP_Y_OFFSET),(SP_OFF_Y,a0)
                            	   247:     move.w  #((\4<<SP_PATTERN_SHIFT)|\6|\7|\5),(SP_OFF_ATTR,a0)
                            	   248:     ENDM
                            	   249: 
                            	   250: ; SPRITE_LINK index, next_index
                            	   251: ; Set the link field of sprite \1 to point to sprite \2
                            	   252: ; \1 = this sprite index (immediate)
                            	   253: ; \2 = next sprite index (immediate, set equal to \1 to terminate chain)
                            	   254: SPRITE_LINK MACRO
                            	   255:     move.w  #(\2&SP_LINK_MASK),(SPRITE_TABLE+(\1*SPRITE_ENTRY_SIZE)+SP_OFF_LINK)
                            	   256:     ENDM
                            	   257: 
                            	   258: ; SPRITE_HIDE index
                            	   259: ; Move a sprite off screen (negative coordinates via offset trick)
                            	   260: ; \1 = sprite index (immediate)
                            	   261: ; Clobbers: a0
                            	   262: SPRITE_HIDE MACRO
                            	   263:     lea     (SPRITE_TABLE+(\1*SPRITE_ENTRY_SIZE)),a0
                            	   264:     clr.w   (SP_OFF_X,a0)          ; X=0 = SP_X_OFFSET-SP_X_OFFSET = off left
                            	   265:     clr.w   (SP_OFF_Y,a0)
                            	   266:     ENDM
                            	   267: 
                            	   268: ; SPRITE_SET_HEAD index
                            	   269: ; Set the sprite display list head in BG_CTRL
                            	   270: ; \1 = first sprite index (immediate)
                            	   271: ; Clobbers: d0
                            	   272: SPRITE_SET_HEAD MACRO
                            	   273:     move.w  (BG_CTRL),d0
                            	   274:     andi.w  #~($FE00),d0            ; clear old head
                            	   275:     ori.w   #((\1)<<BG_SPRITE_HEAD_SHIFT),d0
                            	   276:     move.w  d0,(BG_CTRL)
                            	   277:     ENDM
                            	   278: 
                            	   279: 
                            	   280: ; =============================================================================
                            	   281: ; Interrupt macros
                            	   282: ; =============================================================================
                            	   283: 
                            	   284: ; DISABLE_INTERRUPTS / ENABLE_INTERRUPTS
                            	   285: ;
                            	   286: ; *** DO NOT USE under Human68k user-mode programs ***
                            	   287: ; MOVE SR,<ea> and MOVE <ea>,SR are PRIVILEGED instructions on the 68000.
                            	   288: ; Executing either in user mode (which is how Human68k runs .X executables)
                            	   289: ; raises a privilege violation exception (vector 8) and crashes the program
                            	   290: ; immediately, before any visible output.
                            	   291: ;
                            	   292: ; If supervisor-mode interrupt masking is genuinely required, use the
                            	   293: ; Human68k DOS _SUPER call ($FF20) to switch to supervisor mode first —
                            	   294: ; see doscall.i. For installing interrupt handlers via the vector table,
                            	   295: ; a plain MOVE.L to the vector table address (e.g. VBLANK_VECTOR*4) is a
                            	   296: ; normal RAM write and works fine in user mode without any SR access.
                            	   297: DISABLE_INTERRUPTS  MACRO
                            	   298:     ; intentionally left as a no-op placeholder — see comment above
                            	   299:     ENDM
                            	   300: 
                            	   301: ENABLE_INTERRUPTS   MACRO
                            	   302:     ; intentionally left as a no-op placeholder — see comment above
                            	   303:     ENDM
                            	   304: 
                            	   305: ; SET_VBLANK_VECTOR addr
                            	   306: ; Install a V-blank handler address into the MFP vector table
                            	   307: ; \1 = handler routine label
                            	   308: ; Clobbers: a0
                            	   309: SET_VBLANK_VECTOR   MACRO
                            	   310:     lea     (\1),a0
                            	   311:     move.l  a0,(VBLANK_VECTOR*4)
                            	   312:     ENDM
                            	   313: 
                            	   314: 
                            	   315: ; =============================================================================
                            	   316: ; Utility macros
                            	   317: ; =============================================================================
                            	   318: 
                            	   319: ; WAIT_VBLANK
                            	   320: ; Busy-wait for the start of vertical blank by polling CRTC raster register
                            	   321: ; Clobbers: d0
                            	   322: WAIT_VBLANK MACRO
                            	   323: .wa_wait\@: ; wait for rendering
                            	   324:     btst    #4,MFP_GPDR
                            	   325:     beq     .wa_wait\@
                            	   326: .wvb_wait\@: ; wait for vblank
                            	   327:     btst    #4,MFP_GPDR
                            	   328:     bne     .wvb_wait\@
                            	   329:     ENDM
                            	   330: 
                            	   331: ; SAVE_REGS
                            	   332: ; Push all data and address registers to stack (except SP)
                            	   333: SAVE_REGS   MACRO
                            	   334:     movem.l d0-d7/a0-a6,-(sp)
                            	   335:     ENDM
                            	   336: 
                            	   337: ; RESTORE_REGS
                            	   338: ; Pop all data and address registers from stack
                            	   339: RESTORE_REGS    MACRO
                            	   340:     movem.l (sp)+,d0-d7/a0-a6
                            	   341:     ENDM
                            	   342: 

Source: "sega_logo_x68k.s"
                            	    41:     include "inc/doscall.i"

Source: "inc/doscall.i"
                            	     1: ; =============================================================================
                            	     2: ; doscall.i — Human68k DOS Call Definitions
                            	     3: ;
                            	     4: ; Human68k DOS calls are F-line instructions: the entire $FFxx word IS the
                            	     5: ; instruction. There is no separate TRAP. Usage:
                            	     6: ;
                            	     7: ;   move.w  d0,-(sp)        ; push parameter(s), word-aligned
                            	     8: ;   DOS _PUTCHAR            ; expands to dc.w $FF02
                            	     9: ;   addq.l  #2,sp           ; pop parameter(s)
                            	    10: ;
                            	    11: ; All parameters are pushed right-to-left and must be word or longword sized
                            	    12: ; (never push a single byte — it misaligns the stack and causes an address
                            	    13: ; error on the next instruction).
                            	    14: ;
                            	    15: ; Reference: Human68k DOSCALL specification (doscall.man)
                            	    16: ; =============================================================================
                            	    17: 
                            	    18: ; -----------------------------------------------------------------------
                            	    19: ; DOS macro — emits the F-line word for a given doscall name
                            	    20: ; Usage: DOS _PUTCHAR
                            	    21: ; -----------------------------------------------------------------------
                            	    22: DOS MACRO
                            	    23:     dc.w    __DOS_\1
                            	    24:     ENDM
                            	    25: 
                            	    26: 
                            	    27: ; =============================================================================
                            	    28: ; Character I/O
                            	    29: ; =============================================================================
                            	    30: __DOS__EXIT0       equ $FF00   ; _EXIT — terminate (no return code)
                            	    31: __DOS__GETCHAR     equ $FF01   ; _GETCHAR — read char from stdin, no echo
                            	    32: __DOS__PUTCHAR     equ $FF02   ; _PUTCHAR — write char to stdout (push word)
                            	    33: __DOS__COMINP      equ $FF03   ; _COMINP — direct console input check
                            	    34: __DOS__COMOUT      equ $FF04   ; _COMOUT — direct console output
                            	    35: __DOS__COMISNS     equ $FF05   ; _COMISNS — console input status
                            	    36: __DOS__COMOSNS     equ $FF06   ; _COMOSNS — console output status
                            	    37: __DOS__INPOUT      equ $FF07   ; _INPOUT — char I/O combined
                            	    38: __DOS__INKEY       equ $FF08   ; _INKEY — non-blocking key check
                            	    39: __DOS__PRINT       equ $FF09   ; _PRINT — print string (push longword ptr,
                            	    40:                                 ;          string ends with $00 or $0D)
                            	    41: __DOS__KFLUSH      equ $FF0C   ; _KFLUSH — flush keyboard buffer
                            	    42: __DOS__FFLUSH      equ $FF0D   ; _FFLUSH — flush file buffers
                            	    43: __DOS__CHGDRV      equ $FF0E   ; _CHGDRV — change current drive
                            	    44: __DOS__DRVCTRL     equ $FF0F   ; _DRVCTRL — drive control
                            	    45: 
                            	    46: __DOS__KEYCHK      equ $FF12   ; _KEYCHK — keyboard sense
                            	    47: __DOS__KEYCTRL     equ $FF13   ; _KEYCTRL — keyboard control
                            	    48: 
                            	    49: __DOS__GETENV      equ $FF53   ; _GETENV — get environment variable
                            	    50: __DOS__VERIFY      equ $FF54   ; _VERIFY — set verify flag
                            	    51: 
                            	    52: 
                            	    53: ; =============================================================================
                            	    54: ; File operations
                            	    55: ; =============================================================================
                            	    56: __DOS__CHDIR       equ $FF3B   ; _CHDIR — change directory
                            	    57: __DOS__MKDIR       equ $FF3C   ; _MKDIR — make directory
                            	    58: __DOS__OPEN        equ $FF3D   ; _OPEN — open file
                            	    59:                                 ;   push: mode.w, path_ptr.l
                            	    60:                                 ;   returns: d0.l = handle (negative = error)
                            	    61: __DOS__CREATE      equ $FF3C   ; _CREATE — create file (alias context)
                            	    62: __DOS__CLOSE       equ $FF3E   ; _CLOSE — close file handle
                            	    63:                                 ;   push: handle.l
                            	    64: __DOS__READ        equ $FF3F   ; _READ — read from file
                            	    65:                                 ;   push: handle.l, buffer_ptr.l, length.l
                            	    66:                                 ;   returns: d0.l = bytes read (negative=error)
                            	    67: __DOS__WRITE       equ $FF40   ; _WRITE — write to file
                            	    68:                                 ;   push: handle.l, buffer_ptr.l, length.l
                            	    69: __DOS__DELETE      equ $FF41   ; _DELETE — delete file
                            	    70: __DOS__SEEK        equ $FF42   ; _SEEK — seek within file
                            	    71:                                 ;   push: handle.l, offset.l, mode.w
                            	    72:                                 ;   mode: 0=SEEK_SET 1=SEEK_CUR 2=SEEK_END
                            	    73: __DOS__CHMOD       equ $FF43   ; _CHMOD — change file attributes
                            	    74: __DOS__IOCTRL      equ $FF44   ; _IOCTRL — I/O control
                            	    75: __DOS__DUP         equ $FF45   ; _DUP — duplicate file handle
                            	    76: __DOS__DUP2        equ $FF46   ; _DUP2 — duplicate to specific handle
                            	    77: __DOS__CREATETMP   equ $FF47   ; _CREATETMP — create temp file
                            	    78: 
                            	    79: __DOS__MALLOC      equ $FF48   ; _MALLOC — allocate memory
                            	    80:                                 ;   push: size.l
                            	    81:                                 ;   returns: d0.l = pointer (negative=error)
                            	    82: __DOS__MFREE       equ $FF49   ; _MFREE — free memory block
                            	    83:                                 ;   push: pointer.l
                            	    84: __DOS__SETBLOCK    equ $FF4A   ; _SETBLOCK — resize memory block
                            	    85: __DOS__MALLOC2     equ $FF4B   ; _MALLOC2 — allocate from top of memory
                            	    86: 
                            	    87: __DOS__EXIT2       equ $FF4C   ; _EXIT2 — terminate with return code
                            	    88:                                 ;   push: code.w
                            	    89: __DOS__EXEC        equ $FF4D   ; _EXEC — execute program
                            	    90: __DOS__GETENV2     equ $FF4E   ; _GETENV2
                            	    91: 
                            	    92: __DOS__FFIND       equ $FF4F   ; _FFIND — find first file
                            	    93: __DOS__NFIND       equ $FF50   ; _NFIND — find next file
                            	    94: __DOS__SETDATE     equ $FF51   ; _SETDATE
                            	    95: __DOS__SETTIME     equ $FF52   ; _SETTIME
                            	    96: 
                            	    97: __DOS__SETPDB      equ $FF55   ; _SETPDB — set Process Descriptor Block
                            	    98: __DOS__GETPDB      equ $FF56   ; _GETPDB — get Process Descriptor Block
                            	    99:                                 ;   returns: d0.l = PDB pointer
                            	   100: __DOS__SETENV      equ $FF57   ; _SETENV
                            	   101: __DOS__PATHCHK     equ $FF58   ; _PATHCHK — check path
                            	   102: 
                            	   103: __DOS__GETTIME2    equ $FF5A   ; _GETTIME2
                            	   104: __DOS__SETTIME2    equ $FF5B   ; _SETTIME2
                            	   105: __DOS__NAMECK      equ $FF5C   ; _NAMECK — check filename validity
                            	   106: 
                            	   107: 
                            	   108: ; =============================================================================
                            	   109: ; Process control
                            	   110: ; =============================================================================
                            	   111: __DOS__FORK        equ $FF5D   ; _FORK
                            	   112: __DOS__GETTIME     equ $FF2C   ; _GETTIME
                            	   113: __DOS__GETDATE     equ $FF2A   ; _GETDATE
                            	   114: __DOS__SUPER       equ $FF20   ; _SUPER — switch to supervisor mode
                            	   115:                                 ;   push: 0 (or stack ptr) — see manual
                            	   116:                                 ;   returns: d0.l = old SSP, sets supervisor
                            	   117: __DOS__FNCKEY      equ $FF21   ; _FNCKEY — function key control
                            	   118: __DOS__KEEPPR      equ $FF22   ; _KEEPPR — terminate and stay resident
                            	   119: __DOS__GETTIM2     equ $FF23   ; _GETTIM2
                            	   120: __DOS__SETTIM2     equ $FF24   ; _SETTIM2
                            	   121: __DOS__INTVCS      equ $FF25   ; _INTVCS — set interrupt vector (user-mode safe)
                            	   122:                                 ;   push handler_ptr.l FIRST, then vector_num.w
                            	   123:                                 ;   returns: d0.l = previous handler address
                            	   124:                                 ;   NOTE: was wrongly set to $FF33 (_BREAKCK)
                            	   125:                                 ;   Correct value confirmed from Human68k reference
                            	   126: 
                            	   127: __DOS__GETENVPTR   equ $FF26   ; _GETENVPTR
                            	   128: 
                            	   129: 
                            	   130: __DOS__BREAKCK     equ $FF33   ; _BREAKCK — set break check (NOT _INTVCS)
                            	   131: 
                            	   132: __DOS__ASSIGN      equ $FF35   ; _ASSIGN
                            	   133: __DOS__BUS_ERR     equ $FF3A   ; _BUS_ERR — install bus error handler
                            	   134: 
                            	   135: __DOS__NEWPDB      equ $FF80   ; _NEWPDB — create new PDB (v3 address)
                            	   136: 
                            	   137: ; =============================================================================
                            	   138: ; Common combined sequences as macros
                            	   139: ; These follow the convention: push parameters, emit DOS call, clean stack
                            	   140: ; =============================================================================
                            	   141: 
                            	   142: ; DOS_PUTCHAR_W d0 — print character in d0.b (pushed as word for alignment)
                            	   143: DOS_PUTCHAR_W   MACRO
                            	   144:     move.w  d0,-(sp)
                            	   145:     DOS     _PUTCHAR
                            	   146:     addq.l  #2,sp
                            	   147:     ENDM
                            	   148: 
                            	   149: ; DOS_GETCHAR_D0 — read character into d0.l (no stack params)
                            	   150: DOS_GETCHAR_D0  MACRO
                            	   151:     DOS     _GETCHAR
                            	   152:     ENDM
                            	   153: 
                            	   154: ; DOS_EXIT_CODE n — exit with return code n (immediate)
                            	   155: DOS_EXIT_CODE   MACRO
                            	   156:     move.w  #\1,-(sp)
                            	   157:     DOS     _EXIT2
                            	   158:     ENDM
                            	   159: 
                            	   160: ; DOS_OPEN_FILE — a0=path pointer, mode in d1.w; returns handle in d0.l
                            	   161: DOS_OPEN_FILE   MACRO
                            	   162:     move.w  d1,-(sp)
                            	   163:     move.l  a0,-(sp)
                            	   164:     DOS     _OPEN
                            	   165:     addq.l  #6,sp
                            	   166:     ENDM
                            	   167: 
                            	   168: ; DOS_CLOSE_FILE — d1.l = handle
                            	   169: DOS_CLOSE_FILE  MACRO
                            	   170:     move.l  d1,-(sp)
                            	   171:     DOS     _CLOSE
                            	   172:     addq.l  #4,sp
                            	   173:     ENDM
                            	   174: 
                            	   175: ; DOS_READ_FILE — d1.l=handle, a0=buffer, d2.l=length; returns d0.l=bytes read
                            	   176: DOS_READ_FILE   MACRO
                            	   177:     move.l  d2,-(sp)
                            	   178:     move.l  a0,-(sp)
                            	   179:     move.w  d1,-(sp)
                            	   180:     DOS     _READ
                            	   181:     add.l   #10,sp
                            	   182:     ENDM
                            	   183: 
                            	   184: DOS_SUPER MACRO
                            	   185:     pea     0
                            	   186:     DOS     _SUPER
                            	   187:     addq.l  #4,sp
                            	   188:     ENDM
                            	   189: 

